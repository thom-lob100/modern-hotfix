<UserControl x:Class="Modern.Lab.Controls.Wpf.Data.ModernDataGridControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:data="clr-namespace:Modern.Lab.Controls.Wpf.Data"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="480" d:DesignHeight="240">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/ControlParts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 컬럼 헤더: SemiBold 캡션, 은은한 구분선, 정렬 셰브런.
                 PART_RightHeaderGripper가 마우스로 컬럼 너비 조절이 계속 동작하게 한다. -->
            <Style x:Key="ModernGridColumnHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Brush.GridHeaderBackground}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
                <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
                <!-- 헤더 캡션 기본 정렬은 Center(2026-09-30) — Left·Right 는 컬럼별 스타일(ApplyHeaderAlignment)이 덮는다. -->
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <!-- 헤더-본문 경계(아래)는 Border 선, 컬럼 간 세로
                                     구분은 전체 높이 선 대신 **가운데 짧은
                                     디바이더**(아래 Rectangle — 웹 테이블 문법,
                                     2026-07-31)로 표시한다. -->
                                <Border BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <!-- 오른쪽 끝은 [정렬 글리프][필터 깔때기] 순으로
                                         고정한다 — 깔때기(클릭 버튼)가 셀 맨 오른쪽이라
                                         클릭 위치가 항상 일정하고, 정렬 표시가 나타나도
                                         버튼이 밀리지 않는다. 깔때기는 컬럼의
                                         GridFilterAttach.Filterable(코드가 설정)로 켜진다. -->
                                    <Grid VerticalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <!-- 가운데 정렬 헤더(HeaderAlignment = Center)만 오른쪽 글리프 묶음과 같은 폭의 빈 칸을
                                             왼쪽에 둔다 — 캡션이 글리프를 뺀 칸이 아니라 헤더 전체 폭의 가운데(셀 가운데)에 온다. -->
                                        <Border x:Name="HeaderLeadSpacer"
                                                Grid.Column="0"
                                                Width="{Binding ActualWidth, ElementName=HeaderTrailing}"
                                                Visibility="Collapsed" />
                                        <ContentPresenter x:Name="HeaderContent"
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                                        <StackPanel x:Name="HeaderTrailing" Grid.Column="2" Orientation="Horizontal">
                                        <TextBlock x:Name="SortGlyph"
                                                   Text=""
                                                   FontFamily="{StaticResource Font.Family.Icon}"
                                                   FontSize="{StaticResource Font.Size.IconSm}"
                                                   Margin="4,0,0,0"
                                                   VerticalAlignment="Center"
                                                   Foreground="{StaticResource Brush.TextSecondary}" />
                                        <Button x:Name="FilterButton"
                                                Margin="4,0,0,0"
                                                Cursor="Hand"
                                                Visibility="Collapsed"
                                                Click="OnHeaderFilterClick">
                                            <Button.Template>
                                                <ControlTemplate TargetType="Button">
                                                    <Border Background="Transparent">
                                                        <ContentPresenter VerticalAlignment="Center" />
                                                    </Border>
                                                </ControlTemplate>
                                            </Button.Template>
                                            <TextBlock x:Name="FilterGlyph"
                                                       Text="&#xE71C;"
                                                       FontFamily="{StaticResource Font.Family.Icon}"
                                                       FontSize="{StaticResource Font.Size.IconSm}"
                                                       VerticalAlignment="Center"
                                                       Foreground="{StaticResource Brush.TextSecondary}" />
                                        </Button>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                                </Border>
                                <!-- 컬럼 간 세로 구분 — 헤더 가운데에만 걸치는
                                     14px 디바이더 (전체 높이 선보다 가볍다).
                                     색은 BorderSubtle이 너무 흐려 Border 사용. -->
                                <Rectangle Width="1"
                                           Height="14"
                                           Fill="{StaticResource Brush.Border}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       Width="5"
                                       Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="SortDirection" Value="Ascending">
                                    <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70E;" />
                                </Trigger>
                                <Trigger Property="SortDirection" Value="Descending">
                                    <Setter TargetName="SortGlyph" Property="Text" Value="&#xE70D;" />
                                </Trigger>
                                <Trigger Property="HorizontalContentAlignment" Value="Center">
                                    <Setter TargetName="HeaderLeadSpacer" Property="Visibility" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                                </Trigger>
                                <!-- 컬럼 값 필터: Filterable 컬럼은 깔때기 자리를 항상 잡되(Hidden — 마우스를 올려도 캡션이 밀리지 않고,
                                     Center 캡션은 양쪽 빈 칸이 같아 균형이 맞는다) 헤더에 마우스를 올렸을 때와 필터가 걸린 컬럼(IsActive,
                                     액센트색)에서만 보인다(2026-09-30 사용자 결정). -->
                                <!-- FallbackValue: 채움용(filler) 헤더는 Column이 null이라
                                     바인딩이 실패한다 — 디버거 실행 시 오류 트레이스가
                                     쌓이지 않게 기본값 False로 조용히 처리한다. -->
                                <DataTrigger Binding="{Binding Column.(data:GridFilterAttach.Filterable), RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                                    <Setter TargetName="FilterButton" Property="Visibility" Value="Hidden" />
                                </DataTrigger>
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding Column.(data:GridFilterAttach.Filterable), RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True" />
                                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                    </MultiDataTrigger.Conditions>
                                    <Setter TargetName="FilterButton" Property="Visibility" Value="Visible" />
                                </MultiDataTrigger>
                                <DataTrigger Binding="{Binding Column.(data:GridFilterAttach.IsActive), RelativeSource={RelativeSource Self}, FallbackValue=False}" Value="True">
                                    <Setter TargetName="FilterButton" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="FilterGlyph" Property="Foreground" Value="{StaticResource Brush.Accent}" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 행 배경 주의: DataGrid가 RowBackground/AlternatingRowBackground를
                 행 Background에 전달(TransferProperty)하는 값이 행 스타일
                 트리거보다 우선이라, 행 스타일의 IsSelected/IsMouseOver 트리거는
                 실제로 적용되지 않는다 (실측 확인). 그래서 상태별 행 배경(선택/
                 hover/RowColorMember)은 코드비하인드 PaintRowBackground가 **행
                 로컬 값**으로 칠한다 — 별(*) 폭 반올림으로 셀 사이에 생기는 1px
                 틈까지 행 배경이 덮는다. 여기서는 상태 변화 이벤트만 코드로
                 넘긴다 (Selected/Unselected는 최초 로딩의 자동 선택 행도 잡는다 —
                 SelectionChanged 시점에는 아직 행 컨테이너가 없다). -->
            <Style x:Key="ModernGridRowStyle" TargetType="DataGridRow">
                <EventSetter Event="Selected" Handler="OnRowSelectionStateChanged" />
                <EventSetter Event="Unselected" Handler="OnRowSelectionStateChanged" />
                <EventSetter Event="MouseEnter" Handler="OnRowMouseStateChanged" />
                <EventSetter Event="MouseLeave" Handler="OnRowMouseStateChanged" />
            </Style>

            <!-- 그리드 셀/헤더 체크박스는 공용 파츠(Parts.GridCheckBoxStyle)를 쓴다 —
                 GridColumnFactory가 이 키로 리소스를 조회한다. -->

            <!-- 셀: 내용 세로 중앙 정렬, 셀 단위 포커스 테두리 없음.
                 투명 배경이라 행 배경이 그대로 비쳐 보인다.
                 선택 배경은 행이 아니라 "셀"에서도 칠한다 — RowColorMemberPath가
                 행 Background를 로컬 값으로 설정하면(상태색 행) 행 스타일의
                 IsSelected 트리거가 로컬 값에 밀려 무시되므로, 셀이 위에서 덮어야
                 상태색 행에서도 선택 강조가 보인다. -->
            <Style x:Key="ModernGridCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <!-- 현재 셀 표시 — 그리드의 현재 셀(CurrentCell)
                                     아래쪽에 옅은 액센트 2px **언더라인**
                                     (ModernTabControl의 현재 탭 언더라인과 같은
                                     시각 언어 — 박스 프레임은 과해서 뺐다,
                                     2026-07-31). 코드비하인드가 CurrentCellChanged
                                     에서 그 셀의 BorderBrush/BorderThickness
                                     로컬 값(아래쪽만 2px)을 설정하면 여기서
                                     그대로 그린다 (기본은 두께 0 = 안 보임).
                                     포커스와 무관해 그리드가 포커스를 잃어도
                                     유지된다. -->
                                <data:GridRowMarker />
                                <Border x:Name="CurrentFrame"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False" />
                                <!-- 편집 중인 셀의 액센트 프레임 (엑셀의 편집 셀
                                     문법). 셀 Border 속성 대신 오버레이로 그리는
                                     이유: 내용 위치가 밀리지 않고, 셀 테두리
                                     속성을 쓰는 다른 값과 충돌하지 않는다. -->
                                <Border x:Name="EditFrame"
                                        BorderBrush="{StaticResource Brush.Accent}"
                                        BorderThickness="2"
                                        Visibility="Collapsed"
                                        IsHitTestVisible="False" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!-- 편집 중에는 편집 프레임(2px)이 현재 셀 표시를
                                     겸한다 — 옅은 프레임은 숨긴다. -->
                                <Trigger Property="IsEditing" Value="True">
                                    <Setter TargetName="EditFrame" Property="Visibility" Value="Visible" />
                                    <Setter TargetName="CurrentFrame" Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.SelectedBackground}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.SelectedText}" />
                    </Trigger>
                    <!-- 편집 중인 셀 자체는 표면색으로 — 편집기(TextBox)가 앉는
                         자리라 행 선택색 위에서도 흰 바탕을 보장하고, 템플릿의
                         액센트 프레임과 함께 "이 셀을 고치는 중"을 알린다.
                         행 하이라이트(선택색)는 편집 중에도 그대로 유지된다
                         (2026-07-31 확정 — 편집 위치는 셀 프레임만으로 충분). -->
                    <Trigger Property="IsEditing" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="{StaticResource Radius.Sm}"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <!-- ContentHost: 코드비하인드가 카드 반경에 맞춰 클리핑한다 — Border는
             자식을 둥글게 잘라 주지 않아, 헤더/상태바의 사각 채움이 네 모서리의
             둥근 테두리 선을 덮어 모서리가 끊겨 보이기 때문이다. -->
        <DockPanel x:Name="ContentHost">
            <!-- 상태바: 그리드 하단에 붙는 얇은 요약 스트립.
                 왼쪽은 행 수(StatusCountFormat 형식), 오른쪽은 StatusText.
                 ShowStatusBar가 true일 때만 보인다. -->
            <Border x:Name="StatusBarStrip"
                    DockPanel.Dock="Bottom"
                    Visibility="Collapsed"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="{StaticResource Pad.Field}">
                <DockPanel>
                    <TextBlock x:Name="StatusRightText"
                               DockPanel.Dock="Right"
                               FontSize="{StaticResource Font.Size.Label}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="StatusCountText"
                               FontSize="{StaticResource Font.Size.Label}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                </DockPanel>
            </Border>
            <!-- 집계 푸터 스트립 — 컬럼 정의에 Aggregate가 하나라도 있으면
                 보인다. 셀 배치/폭/스크롤 동기화와 값 계산은
                 GridFooterController가 담당한다. 상태바보다 안쪽(위)에 붙는다. -->
            <!-- 배경은 옅은 액센트 틴트(InfoBackground) — 합계/집계 행이 데이터
                 행·상태바와 구분되어 읽히는 업무 그리드 관례. -->
            <Border x:Name="FooterStrip"
                    DockPanel.Dock="Bottom"
                    Visibility="Collapsed"
                    Height="{StaticResource Size.RowHeight}"
                    Background="{StaticResource Brush.InfoBackground}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,1,0,0">
                <Canvas x:Name="FooterCanvas" ClipToBounds="True" />
            </Border>
            <!-- 찾기 바 자리(Ctrl+F) — GridFindController 가 채운다. 머리글 위에 끼어들어 표를 밀어내린다(2026-10-23). -->
            <Border x:Name="FindBarHost" DockPanel.Dock="Top" Visibility="Collapsed" />
            <!-- 2단 그룹 헤더 스트립 — 컬럼 정의에 HeaderGroup이 하나라도 있으면
                 보인다. 셀 배치/폭/스크롤 동기화는 GridGroupHeaderController가
                 담당한다 (WPF DataGrid는 컬럼 묶음 상단 헤더를 지원하지 않는다). -->
            <Border x:Name="GroupHeaderStrip"
                    DockPanel.Dock="Top"
                    Visibility="Collapsed"
                    Height="{StaticResource Size.GridHeaderHeight}"
                    Background="{StaticResource Brush.GridHeaderBackground}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,0,1">
                <Canvas x:Name="GroupHeaderCanvas" ClipToBounds="True" />
            </Border>
            <Grid>
                <DataGrid x:Name="InnerDataGrid"
                  Background="Transparent"
                  BorderThickness="0"
                  FocusVisualStyle="{x:Null}"
                  ItemsSource="{Binding ItemsSource, ElementName=RootControl}"
                  SelectedItem="{Binding SelectedItem, ElementName=RootControl, Mode=TwoWay}"
                  AutoGenerateColumns="{Binding AutoGenerateColumns, ElementName=RootControl}"
                  IsReadOnly="{Binding ReadOnly, ElementName=RootControl}"
                  CanUserAddRows="False"
                  CanUserDeleteRows="False"
                  CanUserResizeRows="False"
                  CanUserReorderColumns="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  HeadersVisibility="Column"
                  GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="{StaticResource Brush.BorderSubtle}"
                  RowBackground="{StaticResource Brush.Surface}"
                  RowHeight="{StaticResource Size.RowHeight}"
                  ColumnHeaderHeight="{StaticResource Size.GridHeaderHeight}"
                  ColumnHeaderStyle="{StaticResource ModernGridColumnHeaderStyle}"
                  RowStyle="{StaticResource ModernGridRowStyle}"
                  CellStyle="{StaticResource ModernGridCellStyle}"
                  FontSize="{StaticResource Font.Size.Body}"
                  Foreground="{StaticResource Brush.TextPrimary}"
                  EnableRowVirtualization="True"
                  EnableColumnVirtualization="{Binding EnableColumnVirtualization, ElementName=RootControl}"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Auto"
                  SelectionChanged="InnerDataGrid_SelectionChanged" />
                <!-- ScrollUnit=Pixel: 기본(Item)은 줄 단위 스크롤이라, 몇 px만
                     잘린 행(눈에는 온전해 보인다)을 클릭하면 "선택 행은 완전히
                     보여야 한다" 규칙이 한 줄을 통째로 점프시켜 다음 데이터가
                     나온 것처럼 보였다. 픽셀 단위면 모자란 픽셀만큼만 움직인다
                     (실측: 32px 행이 12px 부족 → 12px 이동). 행 가상화는 그대로
                     동작한다. -->

                <!-- 셀 병합(MergeCells) 오버레이 — WPF DataGrid는 셀 스팬을
                     지원하지 않으므로, 병합 구간을 **실제 스팬 셀**(불투명 표면 +
                     세로 중앙 값)로 그리드 위에 그린다. 좌표는 행 높이×인덱스의
                     순수 계산이라 가상화와 무관하게 정확하고, 스크롤/컬럼 폭/
                     고정 구간 동기화는 GridCellMergeController가 담당한다
                     (그룹 헤더·집계 푸터 스트립과 같은 문법). -->
                <Canvas x:Name="MergeCanvas"
                        IsHitTestVisible="False"
                        ClipToBounds="True" />

                <!-- 빈 상태 안내: 데이터가 0건일 때 데이터 영역 가운데에 흐린
                     글씨로 표시한다 (EmptyText, 빈 문자열이면 끔). 헤더는 그대로
                     보이도록 헤더 높이만큼 아래에서 가운데 정렬한다. -->
                <TextBlock x:Name="EmptyLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,34,0,0"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           IsHitTestVisible="False"
                           Visibility="Collapsed"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
