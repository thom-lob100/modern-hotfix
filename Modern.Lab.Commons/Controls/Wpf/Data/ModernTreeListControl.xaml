<UserControl x:Class="Modern.Lab.Controls.Wpf.Data.ModernTreeListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="480" d:DesignHeight="300">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/ControlParts.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 컬럼 헤더: ModernDataGrid와 같은 문법 — 단 트리는 계층 순서가
                 곧 의미라 정렬 글리프/필터 깔때기가 없다. 폭 조절 그리퍼만 유지. -->
            <Style x:Key="TreeListHeaderStyle" TargetType="DataGridColumnHeader">
                <Setter Property="Background" Value="{StaticResource Brush.GridHeaderBackground}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
                <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridColumnHeader">
                            <Grid>
                                <Border BorderBrush="{StaticResource Brush.Border}"
                                        BorderThickness="0,0,0,1">
                                    <Border Background="{TemplateBinding Background}"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter VerticalAlignment="Center" />
                                    </Border>
                                </Border>
                                <!-- 컬럼 간 세로 구분 — 가운데 짧은 디바이더
                                     (ModernDataGridControl 헤더와 동일한 문법). -->
                                <Rectangle Width="1"
                                           Height="14"
                                           Fill="{StaticResource Brush.Border}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           IsHitTestVisible="False" />
                                <Thumb x:Name="PART_RightHeaderGripper"
                                       HorizontalAlignment="Right"
                                       Width="5"
                                       Cursor="SizeWE">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border Background="Transparent" />
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 행 배경 주의: ModernDataGridControl과 동일 — RowBackground 전달값이
                 행 스타일 트리거보다 우선이라 트리거는 적용되지 않는다. 상태별
                 행 배경(선택/hover)은 코드비하인드 PaintRowBackground가 행 로컬
                 값으로 칠하고(1px 틈 커버), 여기서는 상태 변화 이벤트만 넘긴다. -->
            <Style x:Key="TreeListRowStyle" TargetType="DataGridRow">
                <EventSetter Event="Selected" Handler="OnRowSelectionStateChanged" />
                <EventSetter Event="Unselected" Handler="OnRowSelectionStateChanged" />
                <EventSetter Event="MouseEnter" Handler="OnRowMouseStateChanged" />
                <EventSetter Event="MouseLeave" Handler="OnRowMouseStateChanged" />
            </Style>

            <!-- 셀: 내용 세로 중앙, 셀 포커스 테두리 없음 (그리드와 동일). -->
            <Style x:Key="TreeListCellStyle" TargetType="DataGridCell">
                <Setter Property="Padding" Value="{StaticResource Pad.Field}" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="DataGridCell">
                            <Grid>
                                <Border Background="{TemplateBinding Background}"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter VerticalAlignment="Center" />
                                </Border>
                                <!-- 현재 셀 표시 — 그리드와 같은 옅은 액센트 2px 언더라인.
                                     코드비하인드(RefreshCurrentCellMarker)가 현재 셀의
                                     BorderBrush/BorderThickness 로컬 값(아래쪽만 2px)을
                                     설정하면 여기서 그린다 (기본 두께 0 = 안 보임). -->
                                <Border x:Name="CurrentFrame"
                                        BorderBrush="{TemplateBinding BorderBrush}"
                                        BorderThickness="{TemplateBinding BorderThickness}"
                                        IsHitTestVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="{StaticResource Brush.SelectedBackground}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.SelectedText}" />
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!-- 트리 컬럼 셀: [들여쓰기][셰브런][텍스트]. 셰브런은 자식이 없어도
                 자리(Hidden)를 지켜 같은 깊이의 텍스트 기준선이 맞는다. -->
            <DataTemplate x:Key="TreeCellTemplate">
                <StackPanel Orientation="Horizontal">
                    <Border Width="{Binding Indent}" />
                    <Button x:Name="ExpanderButton"
                            Width="16"
                            Focusable="False"
                            Cursor="Hand"
                            VerticalAlignment="Center"
                            Click="OnExpanderClick">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border Background="Transparent">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                            </ControlTemplate>
                        </Button.Template>
                        <TextBlock x:Name="ChevronGlyph"
                                   Text="&#xE76C;"
                                   FontFamily="{StaticResource Font.Family.Icon}"
                                   FontSize="{StaticResource Font.Size.IconSm}"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </Button>
                    <TextBlock Text="{Binding Text}"
                               Margin="4,0,0,0"
                               VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                        <Setter TargetName="ChevronGlyph" Property="Text" Value="&#xE70D;" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding HasChildren}" Value="False">
                        <Setter TargetName="ExpanderButton" Property="Visibility" Value="Hidden" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Border CornerRadius="{StaticResource Radius.Sm}"
            Background="{StaticResource Brush.Surface}"
            BorderBrush="{StaticResource Brush.Border}"
            BorderThickness="1">
        <!-- ContentHost: 코드비하인드가 카드 반경에 맞춰 클리핑한다
             (ModernDataGridControl과 동일한 이유 — 모서리 테두리 끊김 방지). -->
        <DockPanel x:Name="ContentHost">
            <!-- 상태바: ModernDataGridControl 과 같은 스트립 — 왼쪽은 행 수
                 (StatusCountFormat 형식), 오른쪽은 StatusText. ShowStatusBar 가
                 true 일 때만 보인다. -->
            <Border x:Name="StatusBarStrip"
                    DockPanel.Dock="Bottom"
                    Visibility="Collapsed"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="0,1,0,0"
                    Padding="{StaticResource Pad.Field}">
                <DockPanel>
                    <TextBlock x:Name="StatusRightText"
                               DockPanel.Dock="Right"
                               FontSize="{StaticResource Font.Size.Label}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                    <TextBlock x:Name="StatusCountText"
                               FontSize="{StaticResource Font.Size.Label}"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               VerticalAlignment="Center"
                               LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                </DockPanel>
            </Border>
            <!-- 찾기 바 자리(Ctrl+F) — GridFindController 가 채운다. 머리글 위에 끼어들어 표를 밀어내린다(2026-10-23). -->
            <Border x:Name="FindBarHost" DockPanel.Dock="Top" Visibility="Collapsed" />
            <Grid>
                <DataGrid x:Name="InnerDataGrid"
                          Background="Transparent"
                          BorderThickness="0"
                          FocusVisualStyle="{x:Null}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserReorderColumns="False"
                          CanUserSortColumns="False"
                          SelectionMode="Single"
                          SelectionUnit="FullRow"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource Brush.BorderSubtle}"
                          RowBackground="{StaticResource Brush.Surface}"
                          RowHeight="{StaticResource Size.RowHeight}"
                          ColumnHeaderHeight="{StaticResource Size.GridHeaderHeight}"
                          ColumnHeaderStyle="{StaticResource TreeListHeaderStyle}"
                          RowStyle="{StaticResource TreeListRowStyle}"
                          CellStyle="{StaticResource TreeListCellStyle}"
                          FontSize="{StaticResource Font.Size.Body}"
                          Foreground="{StaticResource Brush.TextPrimary}"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Auto"
                          SelectionChanged="InnerDataGrid_SelectionChanged" />

                <!-- 빈 상태 안내 — 그리드와 동일 규칙 (헤더 높이만큼 내려 가운데). -->
                <TextBlock x:Name="EmptyLabel"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Margin="0,34,0,0"
                           FontSize="{StaticResource Font.Size.Body}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           IsHitTestVisible="False"
                           Visibility="Collapsed" />
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
