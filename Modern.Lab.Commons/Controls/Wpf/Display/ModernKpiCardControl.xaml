<UserControl x:Class="Modern.Lab.Controls.Wpf.Display.ModernKpiCardControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="160" d:DesignHeight="72">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/ControlParts.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 카드 표면: 공용 파츠(Parts.CardSurfaceStyle) — 큰 반경(카드 8),
         Flat=True이면 공용 카드 패널 위에서 쓰도록 크롬을 제거한다.
         Tone이 있으면 코드비하인드가 배경/테두리에 지역값을 얹고, 없으면
         ClearValue로 걷어 이 스타일이 그대로 살아난다. -->
    <Border x:Name="Surface" Style="{StaticResource Parts.CardSurfaceStyle}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <!-- 제목이 카드보다 길면 잘라 말줄임한다 — 값·보조 문구와 같은 규칙이다.
                     자르지 않으면 좁은 배치에서 글자가 말줄임 없이 깎여 읽을 수 없다. -->
                <TextBlock x:Name="TitleText"
                           Text="{Binding Title, ElementName=RootControl}"
                           Style="{StaticResource Text.Label}"
                           TextTrimming="CharacterEllipsis"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                <!-- 값 바로 위의 작은 글씨(TopLabel) — 라벨·버튼·그리드 헤더와 같은 10 크기, 보조 색. 비면 자리를 차지하지 않는다. -->
                <TextBlock x:Name="TopLabelText"
                           Text="{Binding TopLabel, ElementName=RootControl}"
                           Margin="0,2,0,0"
                           TextTrimming="CharacterEllipsis"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="{StaticResource Font.Size.SubLabel}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding TopLabel, ElementName=RootControl}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="ValueText"
                           Text="{Binding Value, ElementName=RootControl}"
                           FontSize="{StaticResource Font.Size.Heading}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextPrimary}"
                           Margin="0,2,0,0"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />

                <!-- 값 바로 아래의 작은 글씨(BottomLabel) — 값을 한정하는 짧은 정보(공정·설비 등). TopLabel 과 같은 크기·색이고
                     비면 자리를 차지하지 않는다 — 카드 높이는 글씨가 있을 때만 늘어난다. -->
                <TextBlock x:Name="BottomLabelText"
                           Text="{Binding BottomLabel, ElementName=RootControl}"
                           Margin="0,1,0,0"
                           TextTrimming="CharacterEllipsis"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource Text.Label}">
                            <Setter Property="FontWeight" Value="Normal" />
                            <Setter Property="FontSize" Value="{StaticResource Font.Size.SubLabel}" />
                            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding BottomLabel, ElementName=RootControl}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <!-- 강조(BottomLabelEmphasis): 보조 글씨가 아니라 값에 딸린 둘째 줄 — 자식 장비처럼 값만큼 중요한 때. -->
                                <DataTrigger Binding="{Binding BottomLabelEmphasis, ElementName=RootControl}" Value="True">
                                    <Setter Property="FontSize" Value="{StaticResource Font.Size.BodyLg}" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- 스파크라인: TrendValues가 2개 이상일 때만 값 오른쪽에 나타나는
                 초미니 추세선 — 축/눈금 없는 잉크만으로 "오르는 중/내리는 중"을
                 전달한다. 좌표는 코드비하인드(RebuildTrend)가 계산한다. -->
            <Canvas x:Name="TrendCanvas"
                    Grid.Column="1"
                    Width="64" Height="28"
                    Margin="12,0,0,0"
                    VerticalAlignment="Center"
                    Visibility="Collapsed">
                <Polyline x:Name="TrendLine"
                          Stroke="{StaticResource Brush.Accent}"
                          StrokeThickness="1.5"
                          StrokeLineJoin="Round"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round" />
                <Ellipse x:Name="TrendDot"
                         Width="5" Height="5"
                         Fill="{StaticResource Brush.Accent}" />
            </Canvas>
        </Grid>
    </Border>
</UserControl>
