<UserControl x:Class="Modern.Lab.Controls.Wpf.Display.ModernQueueListControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="240" d:DesignHeight="200">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

            <!-- 한 줄 모드에서만 보이는 요소 — TwoLine 이 true 면 접힌다. -->
            <Style x:Key="OneLineOnly" TargetType="FrameworkElement">
                <Style.Triggers>
                    <DataTrigger Binding="{Binding TwoLine, ElementName=RootControl}" Value="True">
                        <Setter Property="Visibility" Value="Collapsed" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- 줄 컨테이너 — 밑줄 한 줄, 호버 · 선택 색은 토큰. 선택은 테두리 없이 배경으로만 보인다. -->
            <Style x:Key="QueueRowContainer" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="MinHeight" Value="34" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Focusable" Value="True" />
                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                <Setter Property="ToolTip" Value="{Binding ToolTipText}" />
                <Setter Property="ToolTipService.InitialShowDelay" Value="400" />
                <Setter Property="ToolTipService.ShowDuration" Value="20000" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="RowBorder"
                                    Background="Transparent"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="RowBorder" Property="Background" Value="{StaticResource Brush.SelectedBackground}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <EventSetter Event="MouseLeftButtonUp" Handler="OnRowMouseLeftButtonUp" />
                <EventSetter Event="MouseDoubleClick" Handler="OnRowMouseDoubleClick" />
            </Style>

            <!-- 한 줄의 문법 — 왼쪽 띠(Hold · 작업중 · Rework) · 자물쇠(Hold) · 제목(의뢰서) · 부제(랏) · 수량 · 상태 배지 · 꼬리(대기시간).
                 폭이 좁으면(TwoLine) 부제 · 수량 · 꼬리가 둘째 줄로 내려간다. 글자 · 색 종류는 전부 소스 칸에서 오고 이 컨트롤은 그리기만 한다. -->
            <DataTemplate x:Key="QueueRowTemplate">
                <Grid Margin="{Binding Indent}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="7" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="6" />
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0"
                            Margin="0,6,0,6"
                            CornerRadius="1.5"
                            Background="{Binding EdgeBrush}" />
                    <StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center" Margin="0,4,0,4">
                        <DockPanel LastChildFill="True">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="&#xE72E;"
                                       FontFamily="{StaticResource Font.Family.Icon}"
                                       FontSize="{StaticResource Font.Size.Helper}"
                                       Foreground="{StaticResource Brush.WarningText}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,5,0"
                                       Visibility="{Binding IsLocked, Converter={StaticResource BoolToVisibility}}" />
                            <Border DockPanel.Dock="Left"
                                    Background="{StaticResource Brush.NeutralBackground}"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Padding="5,0"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasTag, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding Tag}"
                                           FontSize="{StaticResource Font.Size.Helper}"
                                           Foreground="{StaticResource Brush.NeutralText}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Title}"
                                       FontSize="{StaticResource Font.Size.Body}"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Right"
                                       Style="{StaticResource OneLineOnly}"
                                       Text="{Binding Trailing}"
                                       FontSize="{StaticResource Font.Size.Helper}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <Border DockPanel.Dock="Right"
                                    Background="{Binding BadgeBrush}"
                                    CornerRadius="{StaticResource Radius.Sm}"
                                    Padding="6,1"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Visibility="{Binding HasBadge, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock Text="{Binding BadgeText}"
                                           FontSize="{StaticResource Font.Size.Helper}"
                                           FontWeight="SemiBold"
                                           Foreground="{Binding BadgeForeground}"
                                           VerticalAlignment="Center" />
                            </Border>
                            <Grid Style="{StaticResource OneLineOnly}" Margin="6,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0"
                                           Text="{Binding Subtitle}"
                                           FontSize="{StaticResource Font.Size.Body}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Qty}"
                                           FontSize="{StaticResource Font.Size.Helper}"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center"
                                           Margin="6,0,0,0" />
                            </Grid>
                        </DockPanel>
                        <DockPanel LastChildFill="True"
                                   Margin="0,2,0,0"
                                   Visibility="{Binding TwoLine, ElementName=RootControl, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Subtitle}"
                                       FontSize="{StaticResource Font.Size.Helper}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock DockPanel.Dock="Left"
                                       Text="{Binding Qty}"
                                       FontSize="{StaticResource Font.Size.Helper}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <TextBlock DockPanel.Dock="Right"
                                       Text="{Binding Trailing}"
                                       FontSize="{StaticResource Font.Size.Helper}"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center"
                                       Margin="6,0,0,0" />
                            <Border />
                        </DockPanel>
                    </StackPanel>
                </Grid>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Background="Transparent">
        <ListBox x:Name="RowList"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 SelectionMode="Single"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 VirtualizingPanel.IsVirtualizing="True"
                 ItemContainerStyle="{StaticResource QueueRowContainer}"
                 ItemTemplate="{StaticResource QueueRowTemplate}"
                 SelectionChanged="OnRowListSelectionChanged" />
        <TextBlock x:Name="EmptyLabel"
                   Text="{Binding EmptyText, ElementName=RootControl}"
                   FontSize="{StaticResource Font.Size.Body}"
                   Foreground="{StaticResource Brush.TextPlaceholder}"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   IsHitTestVisible="False"
                   Visibility="Collapsed" />
    </Grid>
</UserControl>
