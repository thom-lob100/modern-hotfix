<UserControl x:Class="Modern.Lab.Controls.Wpf.Display.ModernStageTileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             Cursor="Hand"
             d:DesignWidth="180" d:DesignHeight="64">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 단계 타일 — 큰 숫자 · 단계 이름 · 한 줄 요약 · 장비 램프, 오른쪽 끝에 셰브론. 선택되면 배경이 선택색이다. -->
    <Grid x:Name="TileRoot" Background="{StaticResource Brush.Surface}" MouseLeftButtonUp="OnTileMouseLeftButtonUp">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
        </Grid.ColumnDefinitions>
        <Border x:Name="TileBorder"
                Grid.ColumnSpan="2"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,1" />
        <Grid Grid.Column="0" VerticalAlignment="Center" Margin="12,0,4,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Ellipse x:Name="Lamp"
                     Grid.Column="0"
                     Width="10" Height="10"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Visibility="Collapsed" />
            <TextBlock x:Name="CountText"
                       Grid.Column="1"
                       Text="{Binding Count, ElementName=RootControl}"
                       FontSize="{StaticResource Font.Size.Heading}"
                       FontWeight="Light"
                       Foreground="{StaticResource Brush.TextPrimary}"
                       VerticalAlignment="Center"
                       Margin="0,0,10,0" />
            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                <TextBlock Text="{Binding Label, ElementName=RootControl}"
                           FontSize="{StaticResource Font.Size.Helper}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="SummaryText"
                           Text="{Binding Summary, ElementName=RootControl}"
                           FontSize="{StaticResource Font.Size.Helper}"
                           Foreground="{StaticResource Brush.TextSecondary}"
                           TextTrimming="CharacterEllipsis"
                           Margin="0,1,0,0" />
            </StackPanel>
        </Grid>
        <!-- 셰브론 — 다음 단계로 이어진다는 표시. 마지막 타일은 끈다. -->
        <Path Grid.Column="1"
              Data="M 0,0 L 9,0 L 18,14 L 9,28 L 0,28"
              Stretch="None"
              Stroke="{StaticResource Brush.Border}"
              StrokeThickness="1"
              Fill="{StaticResource Brush.Surface}"
              HorizontalAlignment="Right"
              VerticalAlignment="Center"
              Visibility="{Binding ShowChevron, ElementName=RootControl, Converter={StaticResource BoolToVisibility}}" />
    </Grid>
</UserControl>
