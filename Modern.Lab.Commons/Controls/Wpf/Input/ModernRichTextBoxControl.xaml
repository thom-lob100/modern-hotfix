<UserControl x:Class="Modern.Lab.Controls.Wpf.Input.ModernRichTextBoxControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="400" d:DesignHeight="160">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 서식 텍스트 편집기 — ModernTextBox와 같은 테두리 문법(기본 Border /
         hover BorderHover / 포커스 FocusBorder / 비활성 BorderSubtle). -->
    <Border CornerRadius="{StaticResource Radius.Sm}"
            Background="{StaticResource Brush.Surface}">
        <Border.Style>
            <Style TargetType="Border">
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, ElementName=RootControl}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderHover}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsKeyboardFocusWithin, ElementName=RootControl}" Value="True">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.FocusBorder}" />
                    </DataTrigger>
                    <DataTrigger Binding="{Binding IsEnabled, ElementName=RootControl}" Value="False">
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <!-- CornerClip: 툴바 스트립(사각 채움)이 카드의 둥근 모서리 선을 덮지
             않게 내용을 카드 반경으로 클리핑한다 (그리드와 동일한 이유). -->
        <DockPanel common:CornerClip.IsEnabled="True">
            <!-- 서식 툴바 — 굵게/기울임/밑줄 토글 (같은 서식의 단축키 Ctrl+B/I/U와
                 동일 경로). Focusable=False라 클릭해도 캐럿/선택이 유지된다.
                 선택 위치의 서식 상태를 SelectionChanged에서 되비춘다. -->
            <Border x:Name="ToolbarStrip"
                    DockPanel.Dock="Top"
                    Background="{StaticResource Brush.SurfaceAlt}"
                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                    BorderThickness="0,0,0,1"
                    Padding="4,3">
                <Border.Resources>
                    <Style x:Key="FormatToggleStyle" TargetType="ToggleButton">
                        <Setter Property="Width" Value="26" />
                        <Setter Property="Height" Value="22" />
                        <Setter Property="Margin" Value="1,0" />
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Face"
                                            Background="Transparent"
                                            CornerRadius="{StaticResource Radius.Sm}">
                                        <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Face" Property="Background"
                                                    Value="{StaticResource Brush.HoverBackground}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <!-- 켜진 도구 = 누름 짝 (선택 배경 위 액센트 글자는 7개 테마에서 묻혔다, 2026-10-21) -->
                                            <Setter TargetName="Face" Property="Background"
                                                    Value="{StaticResource Brush.PressedBackground}" />
                                            <Setter Property="Foreground"
                                                    Value="{StaticResource Brush.PressedText}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </Border.Resources>
                <StackPanel Orientation="Horizontal">
                    <ToggleButton x:Name="BoldButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  FontWeight="Bold"
                                  Content="B"
                                  ToolTip="Bold (Ctrl+B)"
                                  Click="OnBoldClick" />
                    <ToggleButton x:Name="ItalicButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  FontStyle="Italic"
                                  Content="I"
                                  ToolTip="Italic (Ctrl+I)"
                                  Click="OnItalicClick" />
                    <ToggleButton x:Name="UnderlineButton"
                                  Style="{StaticResource FormatToggleStyle}"
                                  ToolTip="Underline (Ctrl+U)"
                                  Click="OnUnderlineClick">
                        <TextBlock Text="U" TextDecorations="Underline" />
                    </ToggleButton>
                </StackPanel>
            </Border>

            <!-- WPF RichTextBox를 그대로 편집기로 쓴다(경량안) — 굵게/기울임/밑줄은
                 위 툴바 또는 표준 단축키(Ctrl+B/I/U). 문서 여백은 FlowDocument의
                 PagePadding이 아니라 컨트롤 Padding으로 준다. -->
            <RichTextBox x:Name="Editor"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource Brush.TextPrimary}"
                         FontSize="{StaticResource Font.Size.Body}"
                         Padding="8,6"
                         AcceptsTab="True"
                         VerticalScrollBarVisibility="Auto"
                         HorizontalScrollBarVisibility="Disabled"
                         TextChanged="OnEditorTextChanged"
                         SelectionChanged="OnEditorSelectionChanged" />
        </DockPanel>
    </Border>
</UserControl>
