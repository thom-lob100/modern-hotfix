<UserControl x:Class="Modern.Lab.Controls.Wpf.Input.ModernDropDownButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="110" d:DesignHeight="32">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 보조(Secondary) 버튼 모양의 토글 + 메뉴 팝업.
         ClickMode=Release: Press면 마우스 업이 팝업 밖 입력으로 처리되어 즉시 닫힌다. -->
    <Grid>
        <ToggleButton x:Name="DropToggle"
                      MaxHeight="{StaticResource Size.ControlHeight}"
                      FontWeight="Normal"
                      IsChecked="{Binding IsDropDownOpen, ElementName=RootControl, Mode=TwoWay}"
                      Focusable="False"
                      Cursor="Hand"
                      ClickMode="Release">
            <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="ButtonBorder"
                            CornerRadius="{StaticResource Radius.Sm}"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1">
                        <!-- (선택) 상단 소형 라벨 + [캡션 + 셰브런] 한 줄 + (선택) 하단 소형 라벨 — ModernButton 과 같은 세 줄 묶음.
                             소형 라벨의 Left·Right·Center 는 캡션 덩어리(MainContent) 기준(SubLabelPanel)이고, 색은 캡션 색을 따른다. -->
                        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <common:SubLabelPanel AnchorWidth="{Binding ActualWidth, ElementName=MainContent}">
                                <TextBlock x:Name="TopLabelText"
                                           FontSize="10"
                                           Opacity="0.8"
                                           HorizontalAlignment="{Binding TopLabelAlignment, ElementName=RootControl}"
                                           Margin="0,0,0,-1"
                                           Foreground="{Binding Foreground, ElementName=CaptionText}"
                                           Text="{Binding TopLabel, ElementName=RootControl}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TopLabel, ElementName=RootControl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </common:SubLabelPanel>
                            <StackPanel x:Name="MainContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                                <!-- 캡션 앞 글리프 — ModernButtonControl 의 IconText 와 같은 크기·여백(2026-10-22). 색은 캡션을 따른다. -->
                                <TextBlock x:Name="IconText"
                                           FontFamily="{StaticResource Font.Family.Icon}"
                                           FontSize="{StaticResource Font.Size.Icon}"
                                           VerticalAlignment="Center"
                                           Margin="0,1,8,0"
                                           Foreground="{Binding Foreground, ElementName=CaptionText}"
                                           Text="{Binding IconGlyph, ElementName=RootControl}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IconGlyph, ElementName=RootControl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                                <TextBlock x:Name="CaptionText"
                                           Text="{Binding Text, ElementName=RootControl}"
                                           FontSize="{StaticResource Font.Size.Body}"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           VerticalAlignment="Center"
                                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
                                <TextBlock x:Name="ChevronText"
                                           Text="&#xE70D;"
                                           FontFamily="{StaticResource Font.Family.Icon}"
                                           FontSize="{StaticResource Font.Size.IconSm}"
                                           Margin="6,0,0,0"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                            <common:SubLabelPanel AnchorWidth="{Binding ActualWidth, ElementName=MainContent}">
                                <TextBlock x:Name="BottomLabelText"
                                           FontSize="10"
                                           Opacity="0.8"
                                           HorizontalAlignment="{Binding BottomLabelAlignment, ElementName=RootControl}"
                                           Margin="0,-1,0,0"
                                           Foreground="{Binding Foreground, ElementName=CaptionText}"
                                           Text="{Binding BottomLabel, ElementName=RootControl}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding BottomLabel, ElementName=RootControl}" Value="">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </common:SubLabelPanel>
                        </StackPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.FocusBorder}" />
                        </Trigger>
                        <!-- Primary·Danger·Subtle: ModernButton 과 같은 색 세트(기본·hover·열림). 기본 트리거보다
                             뒤에 둬 hover/열림 상태도 그 종류의 색으로 덮고, 셰브런은 캡션 색을 따른다. -->
                        <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Primary">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Primary" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.AccentHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Primary" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.AccentPressed}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.AccentPressed}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Danger">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.ErrorBorderSoft}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Danger" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.ErrorBorder}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Danger" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.DangerPressed}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="Transparent" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="Transparent" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.PressedBackground}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        </MultiDataTrigger>
                        <!-- Execute: 중요 실행 액션용 Success 초록 채움 (ModernButton과
                             같은 문법). 기본 트리거보다 뒤에 둬 hover/열림 상태도
                             초록 계열로 덮는다. -->
                        <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Execute">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.Success}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Execute" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.SuccessHover}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.SuccessHover}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Execute" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.SuccessPressed}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.SuccessPressed}" />
                        </MultiDataTrigger>
                        <!-- Excel: 내보내기 전용 초록 아웃라인 (ModernButton과 같은
                             문법 — Brush.Excel* 토큰이라 테마별로 다르게 정의된다). -->
                        <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Excel">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.Surface}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.ExcelBorderSoft}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.ExcelText}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.ExcelText}" />
                        </DataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Excel" />
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.ExcelBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.ExcelBorder}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Excel" />
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.ExcelBorderSoft}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.ExcelPressed}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.ExcelPressed}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.ExcelPressed}" />
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ButtonBorder" Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                            <Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                            <Setter TargetName="CaptionText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                            <Setter TargetName="ChevronText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </ToggleButton.Template>
        </ToggleButton>

        <Popup x:Name="ItemsPopup"
               PlacementTarget="{Binding ElementName=DropToggle}"
               Placement="Bottom"
               AllowsTransparency="True"
               Focusable="False"
               StaysOpen="False"
               PopupAnimation="Slide"
               IsOpen="{Binding IsDropDownOpen, ElementName=RootControl, Mode=TwoWay}">
            <!-- PopupBorder: 비활성 항목은 입력을 받지 않아 클릭이 이 테두리에 떨어진다 —
                 코드비하인드가 여기서 좌표로 항목을 찾아 DisabledItemClicked 를 올린다. -->
            <Border x:Name="PopupBorder"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource Radius.Sm}"
                    Margin="0,2,0,0"
                    MinWidth="{Binding ActualWidth, ElementName=DropToggle}">
                <!-- CornerClip: 첫/끝 메뉴 항목 hover 사각 채움이 팝업의 둥근
                     모서리 선을 덮지 않게 클리핑. -->
                <ItemsControl x:Name="MenuItemsControl"
                              common:CornerClip.IsEnabled="True">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <!-- 비활성 항목(IsEnabled=false)은 회색으로 구분되고
                                 클릭되지 않는다 — 컨텍스트 메뉴의 비활성 표시와
                                 같은 의미다. 표시 텍스트 "-"는 구분선으로 그린다
                                 (ToolStripSeparator 관례). -->
                            <Grid>
                                <Button x:Name="ItemButton"
                                        Click="MenuItem_Click"
                                        Focusable="False"
                                        Cursor="Hand"
                                        IsEnabled="{Binding IsEnabled}">
                                    <Button.Template>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="ItemBorder"
                                                    Background="Transparent"
                                                    Padding="{StaticResource Pad.Item}">
                                                <!-- 글리프 칸(GlyphMemberPath 가 있을 때만) + 글자. 끝 단어(AccentText)는 강조색 —
                                                     컨텍스트 메뉴(ModernMenuRenderer)의 글리프 여백·AccentText 와 같은 뜻(2026-10-22).
                                                     두 Run 은 한 줄에 붙여 둔다 — 사이에 줄바꿈이 들어가면 공백이 한 칸 더 생긴다. -->
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <TextBlock x:Name="ItemGlyph"
                                                               FontFamily="{StaticResource Font.Family.Icon}"
                                                               FontSize="{StaticResource Font.Size.Icon}"
                                                               Width="22"
                                                               Margin="0,1,0,0"
                                                               VerticalAlignment="Center"
                                                               Foreground="{StaticResource Brush.TextSecondary}"
                                                               Text="{Binding Glyph}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding ShowGlyph}" Value="False">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock x:Name="ItemText"
                                                               FontSize="{StaticResource Font.Size.Body}"
                                                               Foreground="{StaticResource Brush.TextPrimary}"
                                                               VerticalAlignment="Center"
                                                               LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}"><Run Text="{Binding PrefixText, Mode=OneWay}" /><Run x:Name="ItemAccent" Text="{Binding AccentText, Mode=OneWay}" Foreground="{StaticResource Brush.ErrorText}" /></TextBlock>
                                                </StackPanel>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                                                </Trigger>
                                                <Trigger Property="IsEnabled" Value="False">
                                                    <Setter TargetName="ItemBorder" Property="Background" Value="Transparent" />
                                                    <Setter TargetName="ItemText" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                                    <Setter TargetName="ItemGlyph" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                                    <Setter TargetName="ItemAccent" Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>
                                <Border x:Name="SeparatorLine"
                                        Height="1"
                                        Margin="8,4,8,4"
                                        Background="{StaticResource Brush.BorderSubtle}"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed" />
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSeparator}" Value="True">
                                    <Setter TargetName="ItemButton" Property="Visibility" Value="Collapsed" />
                                    <Setter TargetName="SeparatorLine" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Popup>
    </Grid>
</UserControl>
