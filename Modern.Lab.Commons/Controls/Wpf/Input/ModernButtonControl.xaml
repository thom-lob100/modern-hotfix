<UserControl x:Class="Modern.Lab.Controls.Wpf.Input.ModernButtonControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:common="clr-namespace:Modern.Lab.Controls.Wpf.Common"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             TextOptions.TextFormattingMode="Ideal"
             TextOptions.TextRenderingMode="ClearType"
             UseLayoutRounding="True"
             x:Name="RootControl"
             FontFamily="{DynamicResource Font.Family}"
             d:DesignWidth="120" d:DesignHeight="40">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <common:SharedResourceDictionary Source="/Modern.Lab.Commons;component/Themes/Tokens.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 공용 버튼 스타일: 둥근 모서리, 중앙 정렬 콘텐츠, hover/pressed
                 색상 피드백. 종류별(Primary/Secondary/Danger) 색상은 아래
                 DataTrigger로 전환된다. -->
            <Style x:Key="ModernButtonStyle" TargetType="Button">
                <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
                <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
                <Setter Property="FontWeight" Value="Normal" />
                <Setter Property="MaxHeight" Value="{StaticResource Size.ControlHeight}" />
                <Setter Property="Padding" Value="{StaticResource Pad.Button}" />
                <Setter Property="Cursor" Value="Hand" />
                <!-- 기본값(Primary): 액센트 배경, 흰 텍스트 -->
                <Setter Property="Background" Value="{StaticResource Brush.Accent}" />
                <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Bg"
                                    CornerRadius="{StaticResource Radius.Md}"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <!-- Secondary: 흰 배경, 회색 테두리, 어두운 텍스트 -->
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Secondary">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Border}" />
                    </DataTrigger>
                    <!-- Danger: 아웃라인 빨강 — 흰 배경에 빨간 텍스트와 옅은 빨간 테두리.
                         평소에는 차분하게 유지하고, 상호작용 시에만 빨강이 진해진다. -->
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Danger">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ErrorBorderSoft}" />
                    </DataTrigger>
                    <!-- Subtle: 낮은 강조 액션용 테두리 없는 텍스트 버튼 -->
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle">
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                    </DataTrigger>
                    <!-- Execute: 중요 실행 액션용 Success 초록 채움 -->
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Execute">
                        <Setter Property="Background" Value="{StaticResource Brush.Success}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.OnAccent}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Success}" />
                    </DataTrigger>
                    <!-- Excel: 내보내기 전용 초록 아웃라인 — Surface 배경에 Excel
                         초록 텍스트/옅은 테두리. 색은 Brush.Excel* 토큰이라
                         테마별로 다르게 정의된다 (다크 테마는 밝은 초록). -->
                    <DataTrigger Binding="{Binding Kind, ElementName=RootControl}" Value="Excel">
                        <Setter Property="Background" Value="{StaticResource Brush.Surface}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.ExcelText}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ExcelBorderSoft}" />
                    </DataTrigger>

                    <!-- Primary: hover = 더 진한 파랑, pressed = 가장 진한 파랑 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Primary" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.AccentHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentHover}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Primary" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.AccentPressed}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.AccentPressed}" />
                    </MultiDataTrigger>

                    <!-- Secondary: hover = 옅은 파랑 틴트 + 액센트 테두리/텍스트,
                         pressed = 약간 더 진한 파랑 틴트 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Secondary" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <!-- hover = 중립 HoverBackground + 액센트 테두리 + 누름 글자색(테마마다 그 배경에서 4.5:1 보장).
                             InfoBackground(파란 틴트)는 오렌지·그린 테마와 어긋났고 Light 에서 액센트 글자가 4.2:1 이었다(2026-10-21). -->
                        <Setter Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.PressedText}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Secondary" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <!-- pressed = 전용 누름 짝 — 선택 배경을 빌리면 선택색이 진한 테마에서 글자가 묻힌다(2026-10-21). -->
                        <Setter Property="Background" Value="{StaticResource Brush.PressedBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.Accent}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.PressedText}" />
                    </MultiDataTrigger>

                    <!-- Danger: hover = 옅은 빨강 채움 + 진한 테두리, pressed = 더 진하게 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Danger" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ErrorBorder}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Danger" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <!-- pressed = 오류 배경 + 오류 글자(전 테마 4.5:1) + 진한 테두리. ErrorBorderSoft 위 DangerPressed 글자는 9개 테마에서 묻혔다(2026-10-21). -->
                        <Setter Property="Background" Value="{StaticResource Brush.ErrorBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.DangerPressed}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.ErrorText}" />
                    </MultiDataTrigger>

                    <!-- Subtle: hover = 중립색 채움, pressed = 약간 더 진하게 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.HoverBackground}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Subtle" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <!-- pressed = 누름 짝 (BorderSubtle 위 본문 글자는 HighContrast 에서 2.7:1, 2026-10-21). -->
                        <Setter Property="Background" Value="{StaticResource Brush.PressedBackground}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.PressedText}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                    </MultiDataTrigger>

                    <!-- Execute: hover/pressed = 더 진한 초록 계열 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Execute" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.SuccessHover}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.SuccessHover}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Execute" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.SuccessPressed}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.SuccessPressed}" />
                    </MultiDataTrigger>

                    <!-- Excel: hover = 옅은 초록 채움 + 진한 테두리, pressed = 더 진하게 -->
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Excel" />
                            <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.ExcelBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ExcelBorder}" />
                    </MultiDataTrigger>
                    <MultiDataTrigger>
                        <MultiDataTrigger.Conditions>
                            <Condition Binding="{Binding Kind, ElementName=RootControl}" Value="Excel" />
                            <Condition Binding="{Binding IsPressed, RelativeSource={RelativeSource Self}}" Value="True" />
                        </MultiDataTrigger.Conditions>
                        <Setter Property="Background" Value="{StaticResource Brush.ExcelBorderSoft}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.ExcelPressed}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.ExcelPressed}" />
                    </MultiDataTrigger>

                    <!-- Disabled: 종류와 무관하게 동일한 회색. 위의 종류별 트리거를
                         덮어쓰도록 마지막에 배치한다. -->
                    <Trigger Property="IsEnabled" Value="False">
                        <Setter Property="Background" Value="{StaticResource Brush.DisabledBackground}" />
                        <Setter Property="BorderBrush" Value="{StaticResource Brush.BorderSubtle}" />
                        <Setter Property="Foreground" Value="{StaticResource Brush.DisabledText}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <!-- 실제 버튼: (선택) 상단 소형 라벨 + [아이콘 + 표시 텍스트] 한 줄 + (선택) 하단 소형 라벨.
         세 줄은 본문(MainContent) 폭의 세로 묶음이고 버튼 가운데에 선다. 소형 라벨의 Left·Right·Center 는 본문 글자의 왼쪽 끝·오른쪽 끝·가운데
         기준이라(SubLabelPanel — 그리드 헤더의 위·아래 줄과 같은 규칙, 2026-09-30) 본문보다 길면 기준을 지킨 채 밖으로 나간다. Click은 다시 노출. -->
    <Button x:Name="InnerButton"
            Style="{StaticResource ModernButtonStyle}"
            Click="InnerButton_Click">
        <StackPanel Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Center">
            <common:SubLabelPanel AnchorWidth="{Binding ActualWidth, ElementName=MainContent}">
            <TextBlock x:Name="TopLabelText"
                       FontSize="10"
                       Opacity="0.8"
                       HorizontalAlignment="{Binding TopLabelAlignment, ElementName=RootControl}"
                       Margin="0,0,0,-1"
                       Text="{Binding TopLabel, ElementName=RootControl}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding TopLabel, ElementName=RootControl}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </common:SubLabelPanel>
            <StackPanel x:Name="MainContent" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Center">
                <!-- 캡션 옆 글리프: 본문(12)보다 한 단계 작은 아이콘 크기(Font.Size.Icon=11)로
                     시각 무게를 맞추고, MDL2 글리프는 글자 박스 위쪽에 잉크가 앉아 라틴 캡션보다
                     약 1px 높게 보이므로 위쪽 1px을 띄워 광학 중앙에 맞춘다 (2026-08-29). -->
                <TextBlock x:Name="IconText"
                           FontFamily="{StaticResource Font.Family.Icon}"
                           FontSize="{StaticResource Font.Size.Icon}"
                           VerticalAlignment="Center"
                           Margin="0,1,8,0"
                           Text="{Binding IconGlyph, ElementName=RootControl}">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IconGlyph, ElementName=RootControl}" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
                <TextBlock x:Name="CaptionText"
                           Text="{Binding Text, ElementName=RootControl}" VerticalAlignment="Center"
                           LayoutTransform="{Binding Path=(common:FontWidthScaling.TextWidthTransform), RelativeSource={RelativeSource Self}}" />
            </StackPanel>
            <!-- (선택) 하단 소형 라벨 — 상단 라벨과 같은 크기·불투명도, 정렬은 BottomLabelAlignment(기본 Center). -->
            <common:SubLabelPanel AnchorWidth="{Binding ActualWidth, ElementName=MainContent}">
            <TextBlock x:Name="BottomLabelText"
                       FontSize="10"
                       Opacity="0.8"
                       HorizontalAlignment="{Binding BottomLabelAlignment, ElementName=RootControl}"
                       Margin="0,-1,0,0"
                       Text="{Binding BottomLabel, ElementName=RootControl}">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding BottomLabel, ElementName=RootControl}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            </common:SubLabelPanel>
        </StackPanel>
    </Button>
</UserControl>
