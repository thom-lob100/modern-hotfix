<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- TokyoDay 테마 오버라이드 — Tokyo Night Day 팔레트                -->
    <!-- (folke/tokyonight.nvim). 페리윙클 면(#E1E2E7 배경 · #D8DCE8 표   -->
    <!-- 머리글) + 흰 카드 + 블루 글자(#2F54B5 — 이 테마의 얼굴) + 블루    -->
    <!-- 액센트(#2468CF, 흰 글자) + 블루 선택(#3D59A1, 흰 글자).          -->
    <!-- 원본 액센트 #2E7DE9 와 red #F52A65 는 흰 카드 위 4:1 미만이라      -->
    <!-- 한 단 내렸다(2026-10-22 사용자 선정). TokyoNight 의 라이트 짝.    -->
    <!-- SharedResourceDictionary가 Mode == TokyoDay일 때 병합.          -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 블루 (흰 카드 위 5.3:1, OnAccent 흰색) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF2468CF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF3A7BDD" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF1B54AE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <!-- 선택 강조는 TokyoNight 과 같은 진한 블루 + 흰 글자(6.7:1). -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF3D59A1" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FFD0D5E3" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FF2A4A99" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF2468CF" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#332468CF" />

    <!-- Neutral — Day 사다리: bg → bg_dark(머리글) → border, 카드 표면은 흰색 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFE1E2E7" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF4F5F9" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FFF4F5F9" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FFD8DCE8" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FFF6F7FA" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFB4B5B9" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FFC8CCDA" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF8990B3" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FFEDEFF5" />

    <Color x:Key="Color.Accent">#FF2468CF</Color>
    <Color x:Key="Color.AccentSoft">#FF8FB3EA</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#002468CF</Color>

    <!-- 텍스트 — Day 의 블루 글자. 흰 카드 6.9:1 · 배경 5.3:1 · 머리글 5.0:1. -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF2F54B5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF4E5E9E" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF7A83AB" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FFEDEEF3" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF9AA0BC" />

    <!-- Semantic — Day 의 상태색을 흰 카드 위 4.5:1 에 맞춘 값. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FFDCE8FA" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FFA9C4EE" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF1F5FB8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF587539" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF68884A" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF46612E" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FFDFEBD3" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FFA9C48E" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF46612E" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — Day 의 틸 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF0F7A66" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FFA8DCCF" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FFE3F4EF" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF5FB8A3" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF0A5C4D" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFB15C00" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FFFBE8D0" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFEBC08A" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FF8A4700" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF587539" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFB15C00" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFC8124B" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FFF5B5C8" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FFFCE4EB" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFC8124B" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFA50E3D" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FFE4E7F0" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FF3B4A7A" />

    <Color x:Key="Color.TrackOff">#FFB4B5B9</Color>

</ResourceDictionary>
