<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- ============================================================= -->
    <!-- 디자인 토큰 — 모던하고 보수적인 엔터프라이즈 데스크톱 테마.      -->
    <!-- 컨트롤은 반드시 이 토큰을 사용하고 hex/px/굵기를 하드코딩하지 않는다. -->
    <!--                                                                 -->
    <!-- 팔레트는 세 가지 계열로 축소되어 있다:                           -->
    <!--   Primary  — Fluent 액센트 램프 하나 (액션, 선택, 포커스)         -->
    <!--   Neutral  — 쿨 그레이 램프 하나 (텍스트, 서피스, 테두리, 상태)   -->
    <!--   Semantic — Success / Warning / Error / Info 상태 색상 쌍       -->
    <!-- ============================================================= -->

    <!-- 1. 간격 스케일(4px 그리드). 레이아웃 간격/패딩은 이 값을 사용하며, 그리드를 벗어나지 않는다. -->
    <sys:Double x:Key="Space.Xs">4</sys:Double>
    <sys:Double x:Key="Space.Sm">8</sys:Double>
    <sys:Double x:Key="Space.Md">12</sys:Double>
    <sys:Double x:Key="Space.Lg">16</sys:Double>
    <sys:Double x:Key="Space.Xl">24</sys:Double>

    <!-- 2. 크기 — 필드/버튼은 Compact(32). 그리드 행은 28로 더 촘촘하다:
         한 화면에 더 많은 행을 보고 싶다는 현장 의견(2026-08-25)에 따른
         밀도 실험 — 반응이 나쁘면 32로 원복한다(이 토큰 + 문서를 함께 되돌릴 것). -->
    <sys:Double x:Key="Size.ControlHeight">32</sys:Double>
    <sys:Double x:Key="Size.RowHeight">28</sys:Double>
    <sys:Double x:Key="Size.GridHeaderHeight">36</sys:Double>
    <sys:Double x:Key="Size.FocusThickness">1.5</sys:Double>

    <!-- 파생 레이아웃 토큰 -->
    <Thickness x:Key="Pad.Field">12,0</Thickness>
    <Thickness x:Key="Pad.Item">12,6</Thickness>
    <Thickness x:Key="Pad.Button">16,0</Thickness>
    <Thickness x:Key="Gap.Label">0,0,0,8</Thickness>
    <Thickness x:Key="Gap.Helper">0,4,0,0</Thickness>

    <!-- 3. 모서리 반경(Fluent). Sm/Md는 의도적으로 4를 공유(컨트롤); 카드는 8.
         Fluent 대응: Sm·Md = controlCornerRadius(4), Lg = layerCornerRadius(8).
         Fluent에는 컨트롤 반경이 하나뿐이므로 Sm/Md가 같은 값인 것이 정상이다. -->
    <CornerRadius x:Key="Radius.Sm">4</CornerRadius>
    <CornerRadius x:Key="Radius.Md">4</CornerRadius>
    <CornerRadius x:Key="Radius.Lg">8</CornerRadius>
    <CornerRadius x:Key="Radius.Pill">10</CornerRadius>

    <!-- 4. 색상 — Primary (액센트) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF0078D4" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF106EBE" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF005A9E" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <!-- 선택 강조: 그리드/리스트/트리 공통. 상태색 행 위에서도 구분되면서
         과하지 않은 중간톤 블루(#CFE4F7은 너무 옅고 #9CC9EE는 과함). -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FFB6D9F2" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FF005A9E" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다(2026-10-21). -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FFC7E1F6" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FF005A9E" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF0078D4" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#330078D4" />

    <!-- 색상 — Neutral (서피스 / 테두리 / 텍스트 / 상호작용 상태) -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFF7F8FA" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF9FAFB" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FFEFF3FA" />
    <!-- 그리드 지브라(짝수 행) 전용 — 흰 행과 구분되는 연한 블루 그레이 톤. -->
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FFF6F7F9" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFD1D5DB" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FFE5E7EB" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF9CA3AF" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF111827" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF6B7280" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF8B93A1" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF9CA3AF" />

    <!-- 색상 — Semantic. 각 역할은 (배경, 테두리, 텍스트) 세트로 구성되어, 컨트롤이
         자체적으로 hex를 다시 도출하지 않아도 상태 표시 면의 가독성이 유지된다.
         ErrorBorder는 Danger 버튼 / 필수 표시에 쓰이는 진한 빨강이다. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FFEFF6FF" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FFBFDBFE" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF1D4ED8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF15803D" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF166534" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF14532D" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FFECFDF3" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FFA6F4C5" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF15803D" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) 전용 — Excel 브랜드 초록 계열
         아웃라인: Text=텍스트/평시, BorderSoft=평시 테두리, Background=hover
         채움, Border=hover 테두리, Pressed=눌림 텍스트/테두리. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF217346" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FFA7D7BC" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FFE8F5EE" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF6FBE92" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF17513A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFD97706" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FFFFFBEB" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFFDE68A" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFB45309" />
    <!-- ErrorBorder는 진한 빨강(Danger 버튼 / 필수 표시);
         ErrorBorderSoft는 오류 상태 면에 쓰는 옅은 테두리 색이다. -->
    <!-- 상태색: 성공/경고 (정보=Accent, 오류=ErrorBorder를 겸용) -->
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF16A34A" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFD97706" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFDC2626" />
    <!-- ErrorBorderSoft: 오류 상태 면의 옅은 테두리 + 필수 입력 필드의 테두리 표시 겸용 -->
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FFFECACA" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FFFEF2F2" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFB91C1C" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FF991B1B" />
    <!-- 카운트 배지(버튼/탭 우상단 알약) — 알림용 고정 채도 빨강. ErrorText는
         다크 테마에서 밝은 빨강으로 뒤집혀 흰 글자가 묻히므로 별도 토큰을 둔다
         (Windows 작업표시줄 배지처럼 어느 테마에서도 같은 문법으로 읽히게). -->
    <SolidColorBrush x:Key="Brush.CountBadge" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.OnCountBadge" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FFF3F4F6" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FF374151" />

    <!-- 모달/로딩 배경용 오버레이 스크림(어둡고 반투명). -->
    <SolidColorBrush x:Key="Brush.Scrim" Color="#66101828" />

    <!-- ColorAnimation/그라디언트 대상용 원시 색상 (Brush가 아닌 Color가 필요한 자리) -->
    <Color x:Key="Color.Accent">#FF0078D4</Color>
    <!-- AccentSoft: 액센트의 밝은 변형 — 스피너 그라디언트 끝색 등. 테마가
         Color.Accent를 재정의하면 이 값도 같은 톤으로 함께 재정의한다. -->
    <Color x:Key="Color.AccentSoft">#FF5EB0EE</Color>
    <!-- AccentFade: 액센트와 "같은 RGB"의 완전 투명색(알파 00) — 코멧 테일
         그라디언트의 사라지는 끝색. Transparent(#00FFFFFF)를 끝색으로 쓰면
         WPF가 알파와 RGB를 함께 보간해 중간이 흰끼를 띠므로, 같은 RGB의 알파 0을
         써서 색 변화 없이 투명해지게 한다. 테마가 Color.Accent를 재정의하면
         이 값도 같은 RGB로 함께 재정의한다. -->
    <Color x:Key="Color.AccentFade">#000078D4</Color>
    <Color x:Key="Color.TrackOff">#FFD1D5DB</Color>

    <!-- 5. 타이포그래피. 폰트: Segoe UI(Fluent 시스템 서체), 한글은 Malgun Gothic
         폴백. 위계는 크기 + 굵기로만 표현한다. -->
    <FontFamily x:Key="Font.Family">Segoe UI, Malgun Gothic</FontFamily>

    <!-- 아이콘 글리프 폰트 — 셰브런/체크/캘린더 등 폰트 아이콘 전용.
         컨트롤은 "Segoe MDL2 Assets"를 하드코딩하지 않고 이 토큰을 참조한다. -->
    <FontFamily x:Key="Font.Family.Icon">Segoe MDL2 Assets</FontFamily>

    <!-- 고정폭 폰트 — 오류 창의 기술 상세(예외 원문 · 전문 글자)처럼 "개발자가 읽는 글자"에만 쓴다.
         본문 글꼴과 다르게 보여 현업용 문장과 원문이 한눈에 갈린다. -->
    <FontFamily x:Key="Font.Family.Mono">Consolas, Malgun Gothic</FontFamily>

    <!-- 타입 스케일 (장치 독립 단위; 12 DIU = 9pt, 16 DIU = 12pt).
         컨트롤은 FontSize를 하드코딩하지 않고 이 값을 참조한다.

         Windows 11 / Fluent 공식 램프는 Caption 12 · Body 14 · BodyLarge 18 ·
         Subtitle 20 · Title 28(Semibold)이다. 이 라이브러리는 **의도적으로 두 단계
         낮춰** 본문을 12로 쓴다 — 교체 대상인 기존 WinForms 폼이 Segoe UI 9pt
         (= 12 DIU)로 만들어져 있고, 한 화면에 수십 개 필드가 들어가는 밀도 높은
         업무 데이터 화면에서 14는 레이아웃을 넘치게 한다. **이 값을 Fluent 공식
         14로 "고치지 말 것"** — 기존 폼과 나란히 놓였을 때 글자 크기가 달라진다.
         Fluent를 따르는 부분은 위계 표현 방식이다: 크기 + 굵기만 사용하고
         Bold/Italic은 쓰지 않으며, 같은 크기에서 굵기로 구분한다
         (Helper/Body = Regular, Label = SemiBold — Fluent의 Body / Body Strong 대응).

         램프는 단조 증가해야 한다. 이름이 다른데 값이 같으면 위계를 표현하지 못하고,
         "본문만 키우기" 같은 변경이 의도치 않은 곳까지 번진다. -->
    <!-- 셀 본문과 겹치지 않는 작은 모서리 표식과 한정된 첫 표시 강조. 그리드 헤더 소제목("Durable|Status"의 Durable)도 이 크기다 -->
    <sys:Double x:Key="Font.Size.GridMarker">8</sys:Double>
    <!-- 위·아래 작은 글씨(그리드 헤더·라벨·버튼·그룹 제목) — 표식(GridMarker 8)보다 한 단계 큰 10 (2026-09-29). -->
    <sys:Double x:Key="Font.Size.SubLabel">10</sys:Double>
    <FontWeight x:Key="Font.Weight.GridMarker">SemiBold</FontWeight>
    <Thickness x:Key="Pad.GridMarker">3,0,0,0</Thickness>
    <sys:Double x:Key="Duration.GridMarkerPulse">350</sys:Double>
    <sys:Double x:Key="Opacity.GridMarkerPulse">0.55</sys:Double>
    <sys:Double x:Key="Font.Size.Helper">12</sys:Double>
    <sys:Double x:Key="Font.Size.Label">12</sys:Double>
    <sys:Double x:Key="Font.Size.Body">12</sys:Double>
    <sys:Double x:Key="Font.Size.BodyLg">14</sys:Double>
    <sys:Double x:Key="Font.Size.Title">16</sys:Double>
    <sys:Double x:Key="Font.Size.Subtitle">18</sys:Double>
    <sys:Double x:Key="Font.Size.Heading">20</sys:Double>
    <sys:Double x:Key="Font.Size.PageTitle">22</sys:Double>
    <sys:Double x:Key="Font.Size.Display">28</sys:Double>

    <!-- 아이콘 글리프 크기 (Segoe MDL2 Assets 등 폰트 아이콘 전용).
         IconSm: 셰브런·정렬 화살표 같은 보조 장식, Icon: 체크 표시 같은 상태 글리프. -->
    <sys:Double x:Key="Font.Size.IconSm">10</sys:Double>
    <sys:Double x:Key="Font.Size.Icon">11</sys:Double>

    <!-- 굵기 규칙: 구조 요소(제목, 필드 레이블, 그리드 헤더)는 SemiBold;
         본문, 데이터, 배지는 Regular 유지. 이 두 가지 굵기만 사용한다. -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Font.Family}" />
        <Setter Property="FontSize" Value="{StaticResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 6. 깊이 — 시스템에서 유일하게 허용되는 그림자로, 카드와 오버레이/팝업용. -->
    <DropShadowEffect x:Key="Shadow.Card"
                      Color="#FF000000"
                      Opacity="0.10"
                      BlurRadius="8"
                      ShadowDepth="1"
                      Direction="270" />
    <DropShadowEffect x:Key="Shadow.Popup"
                      Color="#FF101828"
                      Opacity="0.12"
                      BlurRadius="14"
                      ShadowDepth="3"
                      Direction="270" />
    <!-- 로딩 오버레이 카드처럼 화면 위에 떠 있는 요소용 — 팝업보다 뚜렷한 깊이. -->
    <DropShadowEffect x:Key="Shadow.Overlay"
                      Color="#FF1E293B"
                      Opacity="0.28"
                      BlurRadius="22"
                      ShadowDepth="4"
                      Direction="270" />

</ResourceDictionary>
