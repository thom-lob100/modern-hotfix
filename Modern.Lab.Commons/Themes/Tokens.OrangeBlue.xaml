<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- OrangeBlue 테마 오버라이드 — 번트 오렌지 면(#80451E 기반, 밝기 31~35%) -->
    <!-- 위에 연한 블루 액센트(Blue 담당 — 버튼·링크·포커스),              -->
    <!-- 선택 강조도 선명한 블루. 2026-10-20 역할 교체 — 갈색 면 + 오렌지     -->
    <!-- 액센트로는 오렌지가 읽히지 않아(사용자 보고) 면을 오렌지로 올렸다.   -->
    <!-- 뉴트럴/텍스트/시맨틱은 어두운 면 기준으로 전부 재정의한다.         -->
    <!-- SharedResourceDictionary가 Mode == OrangeBlue일 때 병합.        -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 연한 블루 (오렌지 면 위 링크 글자 4.9:1,
         OnAccent는 딥 네이비로 채움 버튼 가독성 확보) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFCFE4FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFE0EEFF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFAFCFFA" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF0B2A4A" />
    <!-- 선택 강조는 선명한 블루 — 오렌지 면 위에서 보색으로 확실히 구분된다. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF2E6DB4" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFEAF3FF" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFCFE4FF" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55CFE4FF" />

    <!-- Neutral (서피스 / 테두리 / 텍스트) — 번트 오렌지(색상 24°, 채도 0.5~0.6) -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF80451E" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF8F4F24" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF995629" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF955328" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FFA35D2E" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF955328" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFBF7340" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FFAE6737" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FFD18E61" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFF7F0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFF6E1CE" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FFE3BD9E" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF9D582A" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF834821" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FFDDB894" />

    <!-- Semantic — 오렌지 면 위 배너는 각 색상의 어두운 면, 글자는 밝은 틴트 -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF2A4C6F" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF386694" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FFCFE6FF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF90DE85" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF63BD57" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF2E6B38" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF3D8F4B" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FFB9F0B0" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 어두운 배경 위 밝은 초록
         아웃라인 (hover 채움은 어두운 초록 면). -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF74CDA0" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF3C5F4D" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF263C31" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF528568" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF95E0BB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFD166" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF776222" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF9E822E" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFFFE9A8" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFFD166" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF9AA3" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FFA14545" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF7A2E2E" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFFC2C7" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFE2606B" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FFB46C3C" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFFFF2E6" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFCFE4FF</Color>
    <Color x:Key="Color.AccentSoft">#FFE8F2FF</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00CFE4FF</Color>
    <Color x:Key="Color.TrackOff">#FFBF8B69</Color>

    <!-- Text.* 스타일 재정의 — 어두운 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
