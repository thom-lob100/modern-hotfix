<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- OrangeBlue 테마 오버라이드 — 웜 미드 그레이 면(#574F4A 기반,       -->
    <!-- CrimsonGray와 같은 밝기) 위에 밝은 오렌지 액센트(Orange 담당),    -->
    <!-- 선택 강조는 블루 틴트 그레이(Blue 담당). 2026-10-19 파스텔에서     -->
    <!-- 중간톤으로 전환 — Light와 확연히 구분되게(사용자 결정).            -->
    <!-- 뉴트럴/텍스트/시맨틱은 어두운 면 기준으로 전부 재정의한다.         -->
    <!-- SharedResourceDictionary가 Mode == OrangeBlue일 때 병합.        -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 밝은 오렌지 (웜 그레이 면에서 또렷하고,
         OnAccent는 딥 브라운-블랙으로 채움 버튼 가독성 확보) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFF08A3E" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFF49C5A" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFDC7629" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF3A1A05" />
    <!-- 선택 강조는 블루 틴트 그레이 — 웜 그레이 화면 위에서 차갑게 구분된다. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF4F6A86" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFDCEBFA" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFF08A3E" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55F08A3E" />

    <!-- Neutral (서피스 / 테두리 / 텍스트) — 웜 미드 그레이 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF574F4A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF635A54" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF6A615B" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF675E58" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF716760" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF685F59" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF7E746C" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF746A63" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF978B82" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF7F3F0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFD4CCC6" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FFB3AAA3" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF6E645E" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF635A54" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FFA1988F" />

    <!-- Semantic — 미드 그레이 면에 맞춘 채도 (CrimsonGray와 같은 값) -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF41505F" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF56697C" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FFAFD3F2" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF90DE85" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF63BD57" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF4E5834" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF66743F" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF9FE295" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 어두운 배경 위 밝은 초록
         아웃라인 (hover 채움은 어두운 초록 면). -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF74CDA0" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF3C5F4D" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF263C31" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF528568" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF95E0BB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFEDBD53" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF5C4E2C" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF7C693B" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFF0C978" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFEDBD53" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF97A0" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF80545A" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF5E4144" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFFB2B9" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFDE6570" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF726862" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFE2DBD6" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFF08A3E</Color>
    <Color x:Key="Color.AccentSoft">#FFF7B98A</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00F08A3E</Color>
    <Color x:Key="Color.TrackOff">#FF958A82</Color>

    <!-- Text.* 스타일 재정의 — 어두운 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
