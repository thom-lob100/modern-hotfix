<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- OrangeBlue 테마 오버라이드 — 채도 있는 블루 면(#1F2F55 배경 ·       -->
    <!-- #27396A 카드 · #2F4480 표 머리글) + 오렌지 액센트(#F4A261, 블루    -->
    <!-- 글자) + 한 단 밝은 블루 선택(#4A6FBF, 흰 글자). 면 자체가 블루라    -->
    <!-- 행을 고르지 않아도 오렌지·블루가 함께 읽힌다(Happy Hues #12 구조). -->
    <!-- 저채도 네이비(#1B2435, 2026-10-21 저녁)는 "파랑"이 아니라 "어두움"  -->
    <!-- 으로 읽혀 채도를 한 단 올렸다(사용자 결정). 라이트 뉴트럴·파스텔·   -->
    <!-- 중간톤 회색도 모두 이름값이 약했다.                                -->
    <!-- SharedResourceDictionary가 Mode == OrangeBlue일 때 병합.        -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 오렌지 (블루 카드 위 링크 5.4:1, OnAccent는 네이비 6.5:1) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFF4A261" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFF7B57E" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFE08C45" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1B2435" />
    <!-- 선택 강조는 한 단 밝은 블루 + 흰 글자(4.9:1) — 블루 면에서 떠오르는 같은 계열. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF4A6FBF" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF3A4F8A" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFF4A261" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55F4A261" />

    <!-- Neutral — 블루 사다리: 배경 → 카드 → 강조 면 → 표 머리글 → 테두리 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF1F2F55" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF27396A" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF2E4176" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF2A3C6E" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF2F4480" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF2B3D70" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3E5490" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF344878" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF5A72B0" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF2F4F8" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFC3CCF0" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF93A0CC" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF31457C" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF27396A" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF8794C4" />

    <!-- Semantic — 블루 면 기준의 밝은 상태색 (Info 는 면보다 밝고 채도 높은 블루, 오류는 연한 빨강) -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF2F5A8C" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF4A78B5" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FFBFE0FF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF6FCF8E" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF86D9A0" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF4FB873" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF233F3A" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF34604F" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF93DEAA" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 네이비 면 위 밝은 초록 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF8CD4A8" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF2F5A4A" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF223C34" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF4D8A6B" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFB6E8C8" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF2C94C" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF3E3A2A" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF66593A" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFF5D77A" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF6FCF8E" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFF2C94C" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF6B3A48" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF4A2E3A" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFFADAD" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFE06565" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF3A4D85" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFE2E8F8" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFF4A261</Color>
    <Color x:Key="Color.AccentSoft">#FFF8C79A</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00F4A261</Color>
    <Color x:Key="Color.TrackOff">#FF55679C</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
