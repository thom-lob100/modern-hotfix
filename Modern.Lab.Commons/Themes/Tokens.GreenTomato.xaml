<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- GreenTomato 테마 오버라이드 — 딥 그린 면(#2F4D3A 기반,             -->
    <!-- CrimsonGray와 같은 밝기) 위에 밝은 그린 액센트(Green 담당),      -->
    <!-- 선택 강조는 토마토 레드(Tomato 담당). 2026-10-19 파스텔 → 그린     -->
    <!-- 그레이 → 그린 면으로 바꿈 — 바탕에서 그린이 읽히게(사용자 결정).   -->
    <!-- 뉴트럴/텍스트/시맨틱은 어두운 면 기준으로 전부 재정의한다.         -->
    <!-- SharedResourceDictionary가 Mode == GreenTomato일 때 병합.       -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 밝은 그린 (딥 그린 면에서 또렷하고,
         OnAccent는 딥 그린-블랙으로 채움 버튼 가독성 확보) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF7FD69A" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF95DEAB" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF62C081" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF0F2E1B" />
    <!-- 선택 강조는 토마토 레드 — 그린 화면 위에서 보색으로 확실히 구분된다. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FFB83E33" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFECE8" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF7FD69A" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#557FD69A" />

    <!-- Neutral (서피스 / 테두리 / 텍스트) — 딥 그린 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF2F4D3A" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF3A5B46" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF42654E" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF3F614B" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF4B6F58" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF40634D" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF628A6E" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF567D62" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF7FA78B" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF1F9F3" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFD0E4D6" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FFA9C7B2" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF476B54" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF345440" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF9EBCA7" />

    <!-- Semantic — 중간톤 어두운 면에 맞춘 채도 (CrimsonGray와 같은 값) -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF41505F" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF56697C" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FFAFD3F2" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF90DE85" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF63BD57" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF4E5834" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF66743F" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF9FE295" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 어두운 배경 위 밝은 초록
         아웃라인 (hover 채움은 어두운 초록 면). -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF74CDA0" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF3C5F4D" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF263C31" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF528568" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF95E0BB" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFEDBD53" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF5C4E2C" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF7C693B" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFF0C978" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF7ED672" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFEDBD53" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF97A0" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF80545A" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF5E4144" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFFB2B9" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFDE6570" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF557C63" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFDEEFE3" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FF7FD69A</Color>
    <Color x:Key="Color.AccentSoft">#FFB4E8C5</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#007FD69A</Color>
    <Color x:Key="Color.TrackOff">#FF7D9C87</Color>

    <!-- Text.* 스타일 재정의 — 어두운 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
