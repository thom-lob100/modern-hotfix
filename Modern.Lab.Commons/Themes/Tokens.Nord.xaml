<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- Nord 테마 오버라이드 — nordtheme.com 정본 팔레트.                -->
    <!-- Polar Night(#2E3440~#4C566A) 청회색 면 + Snow Storm             -->
    <!-- (#D8DEE9~#ECEFF4) 텍스트 + Frost 시안 액센트(nord8 #88C0D0).    -->
    <!-- 시맨틱은 Aurora(red #BF616A / yellow #EBCB8B / green #A3BE8C)   -->
    <!-- 를 청회색 면 기준으로 배치한다. Dark보다 덜 차가운 다크.         -->
    <!-- SharedResourceDictionary가 Mode == Nord일 때 병합.              -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — Frost nord8 #88C0D0, OnAccent는 nord0 (어두운 글자) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF88C0D0" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF9BCBD9" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF6FAEC0" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF2E3440" />
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF3F5872" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFC3E2EC" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다(2026-10-21). -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF566E7E" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFECEFF4" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF88C0D0" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#5588C0D0" />

    <!-- Neutral — Polar Night: 배경 nord0, 카드 nord1, 강조 면 nord2, 테두리 nord3 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF2E3440" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF3B4252" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF434C5E" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF404A5C" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF475164" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF363E4C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF4C566A" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF434D60" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF667389" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFECEFF4" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFC2CAD8" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF8B95A7" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF3F4757" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF3B4252" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF707A8C" />

    <!-- Semantic — Aurora를 청회색 면 기준으로 (텍스트는 반 톤 밝게) -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF394A61" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF4E637F" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF9FBBD8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FFA3BE8C" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FFB1C99D" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF8FAF74" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF3A4537" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF4F5F45" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FFB5CBA1" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 청회색 면 위 뮤트 초록 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF8FBF9C" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF47604F" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF37443C" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF5E8168" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFB8DCC2" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFEBCB8B" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF4A4335" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF665C41" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFEFD49F" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FFA3BE8C" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFEBCB8B" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFD27983" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF6B454B" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF4C363B" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFEBA3AB" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFB34E58" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF434C5E" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFD8DEE9" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FF88C0D0</Color>
    <Color x:Key="Color.AccentSoft">#FFB3D8E3</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#0088C0D0</Color>
    <Color x:Key="Color.TrackOff">#FF525C70</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
