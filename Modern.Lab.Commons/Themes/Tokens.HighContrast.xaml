<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- HighContrast 테마 오버라이드 — 접근성/현장 시인성용 고대비.       -->
    <!-- 순검정 배경 + 순백 텍스트/테두리(면 톤 차이 대신 테두리로 구획을   -->
    <!-- 구분하는 것이 고대비 문법이다). 액센트는 밝은 시안(#6FE0FF)에     -->
    <!-- 검정 글자, 선택 강조는 액센트 면 + 검정 글자. 시맨틱은 검정 위    -->
    <!-- 에서 최대 대비가 나오는 고채도 밝은 색(초록 #3FF23F / 노랑        -->
    <!-- #FFD400 / 빨강 #FF5050)이다. 나쁜 조명·먼 거리·저시력 환경 기준.  -->
    <!-- SharedResourceDictionary가 Mode == HighContrast일 때 병합.       -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 밝은 시안 + 검정 글자, 포커스는 순백 테두리 -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF6FE0FF" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF9AE9FF" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF45C9EE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF6FE0FF" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FF000000" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다(2026-10-21). -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF326573" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#66FFFFFF" />

    <!-- Neutral — 순검정 면 + 순백/밝은 회색 테두리 (hover 피드백은 노랑 테두리) -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF101010" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF0C0C0C" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF141414" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF0A0A0A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FFFFD400" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FFC0C0C0" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF1A1A1A" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF8D8D8D" />

    <!-- Semantic — 검정 위 최대 대비의 고채도 밝은 색. 상태 면은 어두운
         동색 틴트 + 밝은 동색 테두리(면 톤만으로는 고대비에서 안 읽힌다). -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF001A33" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF7CC4FF" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF7CC4FF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF3FF23F" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF66F566" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF2BD32B" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF002B00" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF3FF23F" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF3FF23F" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 검정 위 밝은 초록 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF4FE080" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF14532F" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF002B14" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF4FE080" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF86F0AF" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFFD400" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF332A00" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFFFD400" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFFFD400" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF3FF23F" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFFD400" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF5050" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF8A2A2A" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF330000" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFF6E6E" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFFF2A2A" />
    <!-- 카운트 배지 — 기본 사전은 빨강+흰 글자지만, 고대비에서는 밝은
         빨강 + 검정 글자가 대비가 더 크다(검정 대비 흰 글자보다 우위). -->
    <SolidColorBrush x:Key="Brush.CountBadge" Color="#FFFF5050" />
    <SolidColorBrush x:Key="Brush.OnCountBadge" Color="#FF000000" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF1E1E1E" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#CC000000" />

    <Color x:Key="Color.Accent">#FF6FE0FF</Color>
    <Color x:Key="Color.AccentSoft">#FFB0EEFF</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#006FE0FF</Color>
    <Color x:Key="Color.TrackOff">#FF6E6E6E</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
