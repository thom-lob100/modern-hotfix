<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- Kanagawa 테마 오버라이드 — rebelot/kanagawa.nvim 팔레트(일본 목판화). -->
    <!-- 먹색 면(#1F1F28 sumiInk1 배경 · #2A2A37 카드 · #363646 표 머리글 ·  -->
    <!-- #54546D 테두리) + 크림 글자(#DCD7BA fujiWhite · #C8C093 oldWhite) + -->
    <!-- 사쿠라 핑크(#D27E99) 액센트(먹색 글자) + waveBlue2(#2D4F67) 선택.   -->
    <!-- 시맨틱은 springGreen · roninYellow · peachRed · crystalBlue, Excel 은 -->
    <!-- waveAqua2. 원본 comment(#727169)는 2.9:1 이라 자리표시로 쓰지 않는다 -->
    <!-- (2026-10-23 사용자 선정). SharedResourceDictionary가 Mode == Kanagawa일 때 병합. -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 사쿠라 핑크 (카드 위 링크 4.8:1, OnAccent는 먹색 5.6:1) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFD27E99" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFDF94AB" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFC9758F" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1F1F28" />
    <!-- 선택 강조는 waveBlue2 + 크림 글자(6.0:1) — 팔레트의 visual selection 색. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF2D4F67" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFDCD7BA" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF363646" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFDCD7BA" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFD27E99" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55D27E99" />

    <!-- Neutral — 먹색 사다리: sumiInk1 → 2 → 3 → 4 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF1F1F28" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF2A2A37" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF30303F" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF25252F" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF363646" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF2E2E3C" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF54546D" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF363646" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF727169" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFDCD7BA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFC8C093" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF8A8A9A" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF33334A" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF24242E" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF6C6C7E" />

    <!-- Semantic — 먹색 면 기준의 Kanagawa 상태색. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF223249" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF2D4F67" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF7E9CD8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF98BB6C" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FFA8C97F" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF86A85C" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF2A3A2A" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF3F5A3B" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF98BB6C" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — waveAqua2 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF7AA89F" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF2F4A44" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF263A36" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF4F7A70" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFA9D1C6" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFFF9E3B" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF3F3222" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF6A5230" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFFFB24D" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF98BB6C" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFF9E3B" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF5D62" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF5E3236" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF43282C" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFF8A8E" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFE04A50" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF363646" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFE0DBC4" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFD27E99</Color>
    <Color x:Key="Color.AccentSoft">#FFE6AEBF</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00D27E99</Color>
    <Color x:Key="Color.TrackOff">#FF54546D</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
