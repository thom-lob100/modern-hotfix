<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- LightPink 테마 오버라이드 — LightPurple 과 같은 구조·채도·명도에서  -->
    <!-- 색상을 핑크로 돌리고 면·액센트 채도를 한 단 올린 파스텔(2026-10-22). -->
    <!-- 흰 카드 + 핑크 배경/테두리, 라즈베리 핑크(#BD1558) 액센트.          -->
    <!-- 텍스트/시맨틱 색은 Win11 순정 값으로 아래에서 명시적으로 고정한다. -->
    <!-- SharedResourceDictionary가 Mode == LightPink일 때 병합.         -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 라즈베리 핑크 #BD1558 램프 (흰 카드 위 6.2:1, 배경 위 4.7:1) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFBD1558" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFD01962" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF8E1544" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FFF6C1D6" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FF7A1038" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FFEBC9D8" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FF8E1544" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFBD1558" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#33BD1558" />

    <!-- Neutral — 핑크 램프의 파스텔 배경·테두리 (카드 표면 흰색 유지) -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFF6D9E6" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFFBEDF3" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FFFBEDF3" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FFF0C4D8" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FFFCF3F7" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FFE6A9C6" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FFF2CFDF" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FFD06A96" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FFFAE4EC" />

    <Color x:Key="Color.Accent">#FFBD1558</Color>
    <Color x:Key="Color.AccentSoft">#FFD9789F</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00BD1558</Color>

    <!-- 텍스트/시맨틱 — Win11 순정 값으로 고정. 라이트 기본 팔레트가 바뀌어도
         이 테마가 따라 바뀌지 않도록 여기서 명시적으로 덮는다(LightPurple 과 같은 값). -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF1B1B1B" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF5D5D5D" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF919191" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FFF5F5F5" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF9D9D9D" />
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FFEBF3FC" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FFBBD7F0" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF0C660C" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF094F09" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FFDFF6DD" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FFA9D8A4" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF0F7B0F" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — Excel 브랜드 초록 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF217346" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FFA7D7BC" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FFE8F5EE" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF6FBE92" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF17513A" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FFFFF4CE" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFEDD88F" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FFF2B8B2" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FFFDE7E9" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFA4262C" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FFF0F0F0" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FF3B3B3B" />

    <Color x:Key="Color.TrackOff">#FFC8C8C8</Color>

</ResourceDictionary>
