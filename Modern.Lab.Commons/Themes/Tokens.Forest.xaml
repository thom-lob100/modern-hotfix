<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- Forest 테마 오버라이드 — Everforest Dark(medium) 팔레트.          -->
    <!-- 그린그레이 면(#2D353B 배경 · #343F44 카드 · #3D484D 표 머리글) +  -->
    <!-- 세이지 그린(#A7C080) 액센트(면색 글자) + 딥 그린 선택(#3B5A47,    -->
    <!-- 흰 글자), 글자는 따뜻한 베이지(#D3C6AA). 원본 grey 보조 글자는   -->
    <!-- 3.3:1 이라 #BBB5A4 로 밝혔다(2026-10-22 사용자 선정).             -->
    <!-- SharedResourceDictionary가 Mode == Forest일 때 병합.            -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 세이지 그린 (카드 위 링크 5.4:1, OnAccent는 배경 그린그레이) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFA7C080" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFB8CE96" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF8FAC68" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF2D353B" />
    <!-- 선택 강조는 딥 그린 + 흰 글자(7.7:1) — 액센트 색상의 어두운 단. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF3B5A47" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF475258" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFD3C6AA" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFA7C080" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55A7C080" />

    <!-- Neutral — Everforest 사다리: bg0 → bg1 → bg2 → bg4 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF2D353B" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF343F44" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF3A464B" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF313B41" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF3D484D" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF38434A" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF4F585E" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF434D53" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF7A8478" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFD3C6AA" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFBBB5A4" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF95A197" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF425058" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF2F383E" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF7F8A82" />

    <!-- Semantic — 그린그레이 면 기준의 Everforest 상태색. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF2F474A" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF43646A" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF9CCFC8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FFA7C080" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FFB8CE96" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF8FAC68" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF36473A" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF4C6650" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FFB5D095" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 그린그레이 면 위 아쿠아 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF83C092" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF2F5444" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF2C4540" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF4F8A6E" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFB8E0C2" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFDBBC7F" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF4A4330" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF6E6342" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFE8CD92" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FFA7C080" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFDBBC7F" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFEA8A8C" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF6A4446" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF4C3538" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFF0A0A2" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFD96E70" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF475258" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFE0D9C4" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFA7C080</Color>
    <Color x:Key="Color.AccentSoft">#FFC9DAAE</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00A7C080</Color>
    <Color x:Key="Color.TrackOff">#FF56635F</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
