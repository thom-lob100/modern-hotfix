<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- TokyoNight 테마 오버라이드 — Tokyo Night(night) 팔레트           -->
    <!-- (folke/tokyonight.nvim). 딥 네이비 면(#1A1B26 배경 · #24283B   -->
    <!-- 카드 · #292E42 표 머리글) + 블루(#7AA2F7) 액센트(네이비 글자) +  -->
    <!-- 블루 선택(#3D59A1, 흰 글자), 글자는 라벤더화이트(#C0CAF5).       -->
    <!-- 원본 comment(#565F89)는 2.4:1 이라 자리표시로 쓰지 않는다        -->
    <!-- (2026-10-22 사용자 선정).                                        -->
    <!-- SharedResourceDictionary가 Mode == TokyoNight일 때 병합.        -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 블루 (카드 위 링크 5.8:1, OnAccent는 배경 네이비) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF7AA2F7" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF93B4F9" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF5F8BEE" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1A1B26" />
    <!-- 선택 강조는 진한 블루 + 흰 글자(6.7:1). -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF3D59A1" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF33395A" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFC0CAF5" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF7AA2F7" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#557AA2F7" />

    <!-- Neutral — Tokyo Night 사다리: bg → storm bg(카드) → bg_highlight → border -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF1A1B26" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF24283B" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF2A2F45" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF1F2335" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF292E42" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF272B40" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF3B4261" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF2F3550" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF737AA2" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFC0CAF5" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFA9B1D6" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF7F89B3" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF2F3550" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF1F2335" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF6B729A" />

    <!-- Semantic — 네이비 면 기준의 Tokyo Night 상태색. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF24344F" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF345078" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF7DCFFF" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF9ECE6A" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FFB0DA82" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF86BB52" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF2A3B33" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF3E5A44" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF9ECE6A" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 네이비 면 위 틸 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF73DACA" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF2A5A58" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF233F40" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF41908A" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFB5EDE4" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFE0AF68" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF3D3528" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF66563A" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFE0AF68" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF9ECE6A" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFFF9E64" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFF7768E" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF6A3647" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF4A2A3A" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFF9A3B2" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFE0607A" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF3B4261" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFD8DEF8" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FF7AA2F7</Color>
    <Color x:Key="Color.AccentSoft">#FFB4C8FA</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#007AA2F7</Color>
    <Color x:Key="Color.TrackOff">#FF3B4261</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
