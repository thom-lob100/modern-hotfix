<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- DarkGold 테마 오버라이드 — 차콜 면(#1A1814 배경 · #24211B 카드 ·   -->
    <!-- #2E2A22 표 머리글) + 골드 액센트(#E0B45A, 차콜 글자) + 딥 틸 선택  -->
    <!-- (#1F4F5A, 흰 글자). 골드가 액센트 하나뿐이라 선택은 보색인 틸이   -->
    <!-- 맡고, 경고색은 골드와 겹치지 않게 오렌지로 둔다(2026-10-21 사용자  -->
    <!-- 결정, 게임 UI 팔레트 검토).                                      -->
    <!-- SharedResourceDictionary가 Mode == DarkGold일 때 병합.          -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 골드 (차콜 카드 위 링크 7.7:1, OnAccent는 차콜) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FFE0B45A" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FFE8C375" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FFC99A3F" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FF1A1814" />
    <!-- 선택 강조는 딥 틸 + 흰 글자(9:1) — 골드의 보색. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF1F4F5A" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FF3A352B" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FFF3EDE0" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FFE0B45A" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#55E0B45A" />

    <!-- Neutral — 웜 차콜 사다리: 배경 → 카드 → 강조 면 → 표 머리글 → 테두리 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FF1A1814" />
    <SolidColorBrush x:Key="Brush.Surface" Color="#FF24211B" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FF2B2720" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FF28241D" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FF2E2A22" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FF28241E" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF443D30" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FF36302A" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF6A5F4A" />
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FFF3EDE0" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FFC9BFA8" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF8F8470" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FF2E2A22" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FF24211B" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF7E7462" />

    <!-- Semantic — 차콜 면 기준의 밝은 상태색. 경고는 골드와 겹치지 않게 오렌지. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FF2A3A44" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FF3F5868" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF9CCDE8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF86C58A" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF9AD19D" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF6AAE6E" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FF27352A" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FF3C5440" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FFA6D9A8" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 차콜 면 위 밝은 초록 아웃라인. -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF8FCFA6" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FF35584A" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FF243A31" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF4F8A6A" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FFB8E6C8" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FFF0924A" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FF46331F" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FF6B4A2A" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FFF5B07A" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF86C58A" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FFF0924A" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFFF8A8A" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FF6B3F3B" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FF4B2F2C" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFFFADAD" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFE06565" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FF3A352B" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FFE6DFD0" />

    <SolidColorBrush x:Key="Brush.Scrim" Color="#99000000" />

    <Color x:Key="Color.Accent">#FFE0B45A</Color>
    <Color x:Key="Color.AccentSoft">#FFEFD39A</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#00E0B45A</Color>
    <Color x:Key="Color.TrackOff">#FF5A5243</Color>

    <!-- Text.* 스타일 재정의 — 어두운 면 전경 (Dark와 동일 이유) -->
    <Style x:Key="Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Label" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Label}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
    </Style>
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
    </Style>
    <Style x:Key="Text.Helper" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Font.Family}" />
        <Setter Property="FontSize" Value="{DynamicResource Font.Size.Helper}" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

</ResourceDictionary>
