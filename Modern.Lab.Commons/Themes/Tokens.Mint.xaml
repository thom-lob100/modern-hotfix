<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================= -->
    <!-- Mint 테마 오버라이드 — Radix Colors Teal 라이트 스케일(radix-ui.com). -->
    <!-- 민트 면(#CCF3EA 배경 = teal-4 · #B8EAE0 표 머리글 = teal-5 ·      -->
    <!-- #83CDC1 테두리 = teal-7) + 흰 카드 + 딥 틸 글자(#0D3D38 = teal-12,   -->
    <!-- 이 테마의 얼굴) + 틸 액센트(#00705F, teal-11 보다 한 단 진하게 —  -->
    <!-- 원본 #008573 은 배경 위 3.8:1) + 딥 틸 선택(#0E5F55, 흰 글자).     -->
    <!-- 시맨틱은 Win11 순정, Excel 만 틸과 벌리려 진한 초록(2026-10-22).  -->
    <!-- SharedResourceDictionary가 Mode == Mint일 때 병합.              -->
    <!-- ============================================================= -->

    <!-- Primary (액센트) — 틸 (흰 카드 위 6.0:1 · 배경 위 5.1:1, OnAccent 흰색) -->
    <SolidColorBrush x:Key="Brush.Accent" Color="#FF00705F" />
    <SolidColorBrush x:Key="Brush.AccentHover" Color="#FF008573" />
    <SolidColorBrush x:Key="Brush.AccentPressed" Color="#FF005A4C" />
    <SolidColorBrush x:Key="Brush.OnAccent" Color="#FFFFFFFF" />
    <!-- 선택 강조는 딥 틸 + 흰 글자(7.5:1) — Radix teal-9(#12A594)는 흰 글자 3.1:1 이라 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.SelectedBackground" Color="#FF0E5F55" />
    <SolidColorBrush x:Key="Brush.SelectedText" Color="#FFFFFFFF" />
    <!-- 누름(pressed) 전용 짝 — 보조 버튼·토글·메뉴 항목을 누르는 순간. 선택 배경을 빌려 쓰지 않는다. -->
    <SolidColorBrush x:Key="Brush.PressedBackground" Color="#FFA1DED2" />
    <SolidColorBrush x:Key="Brush.PressedText" Color="#FF0D3D38" />
    <SolidColorBrush x:Key="Brush.FocusBorder" Color="#FF00705F" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="#3300705F" />

    <!-- Neutral — Radix teal 2~7단: 배경 · 머리글 · 테두리, 카드 표면은 흰색 -->
    <SolidColorBrush x:Key="Brush.Background" Color="#FFCCF3EA" />
    <SolidColorBrush x:Key="Brush.SurfaceAlt" Color="#FFF3FBF9" />
    <SolidColorBrush x:Key="Brush.HeaderBackground" Color="#FFF3FBF9" />
    <SolidColorBrush x:Key="Brush.GridHeaderBackground" Color="#FFB8EAE0" />
    <SolidColorBrush x:Key="Brush.GridRowAlt" Color="#FFF6FCFA" />
    <SolidColorBrush x:Key="Brush.Border" Color="#FF83CDC1" />
    <SolidColorBrush x:Key="Brush.BorderSubtle" Color="#FFA1DED2" />
    <SolidColorBrush x:Key="Brush.BorderHover" Color="#FF53B9AB" />
    <SolidColorBrush x:Key="Brush.HoverBackground" Color="#FFE0F8F3" />

    <Color x:Key="Color.Accent">#FF00705F</Color>
    <Color x:Key="Color.AccentSoft">#FF53B9AB</Color>
    <!-- 코멧 테일 페이드 끝색 — 액센트와 같은 RGB의 알파 0. -->
    <Color x:Key="Color.AccentFade">#0000705F</Color>

    <!-- 텍스트 — 딥 틸(teal-12). 흰 카드 12:1 · 배경 10:1 · 머리글 9:1. -->
    <SolidColorBrush x:Key="Brush.TextPrimary" Color="#FF0D3D38" />
    <SolidColorBrush x:Key="Brush.TextSecondary" Color="#FF2F6B63" />
    <SolidColorBrush x:Key="Brush.TextPlaceholder" Color="#FF6A948D" />
    <SolidColorBrush x:Key="Brush.DisabledBackground" Color="#FFEEF6F4" />
    <SolidColorBrush x:Key="Brush.DisabledText" Color="#FF8FB1AB" />

    <!-- 시맨틱 — Win11 순정 값(LightPurple 과 같음). Excel 만 틸 액센트와 겹치지 않게 진한 초록. -->
    <SolidColorBrush x:Key="Brush.InfoBackground" Color="#FFEBF3FC" />
    <SolidColorBrush x:Key="Brush.InfoBorder" Color="#FFBBD7F0" />
    <SolidColorBrush x:Key="Brush.InfoText" Color="#FF005FB8" />
    <SolidColorBrush x:Key="Brush.Success" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.SuccessHover" Color="#FF0C660C" />
    <SolidColorBrush x:Key="Brush.SuccessPressed" Color="#FF094F09" />
    <SolidColorBrush x:Key="Brush.SuccessBackground" Color="#FFDFF6DD" />
    <SolidColorBrush x:Key="Brush.SuccessBorder" Color="#FFA9D8A4" />
    <SolidColorBrush x:Key="Brush.SuccessText" Color="#FF0F7B0F" />
    <!-- Excel 내보내기 버튼(ButtonKind.Excel) — 진한 초록 아웃라인(틸 액센트와 구분). -->
    <SolidColorBrush x:Key="Brush.ExcelText" Color="#FF1E6B2F" />
    <SolidColorBrush x:Key="Brush.ExcelBorderSoft" Color="#FFA9D8A4" />
    <SolidColorBrush x:Key="Brush.ExcelBackground" Color="#FFE8F5EE" />
    <SolidColorBrush x:Key="Brush.ExcelBorder" Color="#FF5FB36F" />
    <SolidColorBrush x:Key="Brush.ExcelPressed" Color="#FF14501F" />
    <SolidColorBrush x:Key="Brush.Warning" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.WarningBackground" Color="#FFFFF4CE" />
    <SolidColorBrush x:Key="Brush.WarningBorder" Color="#FFEDD88F" />
    <SolidColorBrush x:Key="Brush.WarningText" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.StatusSuccess" Color="#FF0F7B0F" />
    <SolidColorBrush x:Key="Brush.StatusWarning" Color="#FF9D5D00" />
    <SolidColorBrush x:Key="Brush.ErrorBorder" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.ErrorBorderSoft" Color="#FFF2B8B2" />
    <SolidColorBrush x:Key="Brush.ErrorBackground" Color="#FFFDE7E9" />
    <SolidColorBrush x:Key="Brush.ErrorText" Color="#FFC42B1C" />
    <SolidColorBrush x:Key="Brush.DangerPressed" Color="#FFA4262C" />
    <SolidColorBrush x:Key="Brush.NeutralBackground" Color="#FFE6F1EE" />
    <SolidColorBrush x:Key="Brush.NeutralText" Color="#FF2F4C47" />

    <Color x:Key="Color.TrackOff">#FFA1DED2</Color>

</ResourceDictionary>
